---
import ArrowIcon from "./ArrowIcon.astro";
import { centros } from "../data/centros";
import { territorios, corDoTerritorio } from "../data/territorios";
const tiposPrincipais = ["CEIP", "CPI", "IES", "CIFP", "EEI"];
const todosOsTipos = [...new Set(centros.map((centro) => centro.tipo))].filter(Boolean);
const tipos = [
  ...tiposPrincipais.filter((tipo) => todosOsTipos.includes(tipo)),
  ...todosOsTipos.filter((tipo) => !tiposPrincipais.includes(tipo)).sort(),
];

const counts = {
  activas: centros.filter((centro) => centro.estado === "activa").length,
};

// Mesma orde en todos os sitios (ver corDoTerritorio en territorios.ts): os
// territorios oficiais na súa orde do CMS, despois os "núcleo" dun só
// centro (ver centros.ts), ordenados alfabeticamente entre eles. Así a cor
// dun territorio é sempre a mesma na lenda e no mapa.
const nucleosOrdenados = [...new Set(
  centros.filter((centro) => centro.nucleo).map((centro) => centro.territorio as string)
)].sort((a, b) => a.localeCompare(b, "gl"));
const universoTerritorios = [...territorios.map((territorio) => territorio.nome), ...nucleosOrdenados];
---

<section id="mapa" class="border-y border-ink/20 bg-ink text-paper">
  <div class="mx-auto max-w-[1600px]">
    <div class="grid lg:grid-cols-[minmax(320px,430px)_1fr]">
      <aside class="flex flex-col border-paper/20 p-5 sm:p-8 lg:border-r lg:p-10">
        <h2 class="display type-display-section max-w-sm">Mapa das asembleas</h2>
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-paper/70">
          Un mapa da rede que xa está en movemento. Busca o teu centro para saber se conta cunha asemblea ou para comezar a organizala.
        </p>

        <a
          href="/#participa"
          class="focus-ring mt-6 inline-flex w-fit items-center rounded-[4px] border border-paper/40 px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-paper hover:border-paper hover:bg-paper hover:text-ink"
        >
          Quero rexistrar a miña asemblea
        </a>

        <div class="mt-8 border-y border-paper/20 py-5">
          <div>
            <strong id="count-active" class="display block text-4xl text-[#83a678]">{counts.activas}</strong>
            <span class="text-[10px] uppercase tracking-wider text-paper/55">Asembleas activas</span>
          </div>
        </div>

        <div class="mt-7 grid gap-3">
          <label for="map-search" class="text-xs font-bold text-paper/70">Busca na rede de centros</label>
          <input
            id="map-search"
            type="search"
            placeholder="Centro, concello ou comarca"
            class="focus-ring w-full rounded-[4px] border border-paper/30 bg-transparent px-4 py-3 text-sm text-paper placeholder:text-paper/40"
          />
          <div>
            <select id="type-filter" aria-label="Filtrar por tipo de centro" class="focus-ring w-full rounded-[4px] border border-paper/25 bg-ink px-3 py-3 text-[11px] text-paper/75">
              <option value="">Todos os tipos</option>
              {tipos.map((tipo) => <option value={tipo}>{tipo}</option>)}
            </select>
          </div>
        </div>

        {territorios.length > 0 && (
          <details open class="group mt-8 border-t border-paper/20 pt-6">
            <summary class="focus-ring flex cursor-pointer list-none items-center justify-between gap-2 text-[10px] uppercase tracking-wider text-paper/55 [&::-webkit-details-marker]:hidden">
              <span>Territorios (intercentros)</span>
              <ArrowIcon direction="down" class="shrink-0 text-paper/40 transition-transform group-open:rotate-180" />
            </summary>
            <ul class="mt-3 grid gap-1.5 text-[11px] text-paper/80">
              {territorios.map((territorio) => (
                <li class="flex items-center gap-2">
                  <i class="h-2.5 w-2.5 shrink-0 rounded-full" style={`background:${corDoTerritorio(territorio.nome, universoTerritorios)}`}></i>
                  {territorio.nome}
                </li>
              ))}
            </ul>
            <p class="mt-3 text-[10px] leading-relaxed text-paper/45">
              Agrupación real por concellos -- pode cambiar. Pasa por riba dun territorio no mapa para velo enteiro. Un concello cun só centro aínda sen agrupar aparece tamén coloreado, coma "núcleo" propio á espera de que outros se lle unan.
            </p>
          </details>
        )}

        <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-8 text-[10px] uppercase tracking-wider text-paper/55">
          <span class="flex items-center gap-2"><i class="h-2.5 w-2.5 rounded-full bg-green-600"></i> Activa</span>
          <span class="flex items-center gap-2"><i class="h-2.5 w-2.5 rounded-full bg-[#6f6c66]"></i> Resultado de busca</span>
        </div>
      </aside>
      <div class="relative min-h-[520px] bg-[#dedbd4] sm:min-h-[620px] lg:min-h-[720px]">
        <div id="assembly-map" class="absolute inset-0" aria-label="Mapa interactivo dos centros educativos de Galiza"></div>
        <p id="map-results" class="absolute bottom-3 left-3 z-[500] rounded-[4px] bg-paper px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-ink shadow-hard-sm">
          {counts.activas} asembleas na rede
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import L from "leaflet";
  import { centros } from "../data/centros";
  import { territorios, territorioDoConcello, normalizarConcello, corDoTerritorio } from "../data/territorios";

  type Estado = "activa" | "creacion" | "sen_asemblea";
  type Centro = (typeof centros)[number];

  const colors: Record<Estado, string> = {
    activa: "#355a2c",
    creacion: "#6f6c66",
    sen_asemblea: "#6f6c66",
  };

  const labels: Record<Estado, string> = {
    activa: "Asemblea activa",
    creacion: "Aínda sen asemblea activa",
    sen_asemblea: "Sen asemblea activa",
  };

  const mapElement = document.querySelector<HTMLElement>("#assembly-map");
  if (mapElement) {
    const map = L.map(mapElement, {
      zoomControl: false,
      minZoom: 7,
      maxZoom: 16,
      scrollWheelZoom: true,
    }).setView([42.85, -8.05], 8);
    map.createPane("territories");
    const territoryPane = map.getPane("territories");
    if (territoryPane) {
      territoryPane.style.zIndex = "250";
    }

    L.control.zoom({ position: "topright" }).addTo(map);

    // Límites reais de Galiza, calculados a partir do propio GeoJSON en
    // canto carga (ver máis abaixo) -- así non hai que inventar
    // coordenadas a man nin arriscarse a deixar ver Asturias ou Castela e
    // León polo bordo. O botón de recentrar reutiliza estes mesmos límites.
    let limitesGalicia: L.LatLngBounds | null = null;
    const RecentrarControl = L.Control.extend({
      options: { position: "topright" },
      onAdd() {
        const contedor = L.DomUtil.create("div", "leaflet-bar leaflet-control");
        const boton = L.DomUtil.create("a", "", contedor) as HTMLAnchorElement;
        boton.href = "#";
        boton.title = "Centrar en Galiza";
        boton.setAttribute("aria-label", "Centrar en Galiza");
        boton.style.display = "flex";
        boton.style.alignItems = "center";
        boton.style.justifyContent = "center";
        boton.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="7"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path></svg>';
        L.DomEvent.disableClickPropagation(contedor);
        L.DomEvent.on(boton, "click", (event) => {
          L.DomEvent.preventDefault(event);
          if (limitesGalicia) map.fitBounds(limitesGalicia);
        });
        return contedor;
      },
    });
    new RecentrarControl().addTo(map);

    // Sen fondo de OpenStreetMap a propósito: así Galiza debúxase só cos
    // nosos propios datos (concellos agrupados por territorio), sen
    // topónimos, mar nin posibilidade de navegar fóra do país.
    //
    // Cada territorio -- incluídos os "núcleo" dun só centro -- ten a súa
    // propia cor (corDoTerritorio, en territorios.ts). O peso e opacidade
    // do bordo son SEMPRE os mesmos para calquera territorio, agrupado ou
    // núcleo: só cambia o matiz. O único concello "solto" (sen territorio
    // nin núcleo) ten un bordo e recheo neutros, tamén sempre iguais. Así
    // non hai bordos "gordos" nalgúns sitios e finos noutros sen motivo.
    const CONCELLO_SOLTO = { color: "#f2f0ec", weight: 1, opacity: 0.5, fillColor: "#c7c4bc", fillOpacity: 0.14 };

    // Núcleo: ver a mesma lóxica (e por que) en centros.ts. Aquí só
    // precisamos saber, por concello normalizado, se ten un centro único
    // sen territorio oficial e cal sería o nome dese territorio sintético.
    const nucleoPorConcelloNormalizado = new Map<string, string>();
    for (const centro of centros) {
      if (centro.nucleo && centro.territorio) {
        nucleoPorConcelloNormalizado.set(normalizarConcello(centro.concello), centro.territorio);
      }
    }

    // Mesma orde que no frontmatter deste compoñente -- ver alí o motivo.
    const nucleosOrdenados = [...new Set(
      centros.filter((centro) => centro.nucleo).map((centro) => centro.territorio as string)
    )].sort((a, b) => a.localeCompare(b, "gl"));
    const universoTerritorios = [...territorios.map((territorio) => territorio.nome), ...nucleosOrdenados];

    const estiloBase = (nomeTerritorio: string) => {
      const cor = corDoTerritorio(nomeTerritorio, universoTerritorios);
      return { color: cor, weight: 1.1, opacity: 0.55, fillColor: cor, fillOpacity: 0.16 };
    };
    const estiloRealzado = (nomeTerritorio: string) => {
      const cor = corDoTerritorio(nomeTerritorio, universoTerritorios);
      return { color: cor, weight: 2.2, opacity: 0.95, fillColor: cor, fillOpacity: 0.32 };
    };

    function territorioEfectivo(nomeConcello: string): { nome: string; nucleo: boolean } | undefined {
      const oficial = territorioDoConcello(nomeConcello);
      if (oficial) return { nome: oficial, nucleo: false };
      const nucleo = nucleoPorConcelloNormalizado.get(normalizarConcello(nomeConcello));
      return nucleo ? { nome: nucleo, nucleo: true } : undefined;
    }

    const centrosActivosPorTerritorio = new Map<string, Centro[]>();
    for (const centro of centros) {
      if (centro.estado !== "activa" || !centro.territorio) continue;
      const lista = centrosActivosPorTerritorio.get(centro.territorio) ?? [];
      lista.push(centro);
      centrosActivosPorTerritorio.set(centro.territorio, lista);
    }

    // Capas de cada territorio, para poder realzalas tódas xuntas cando se
    // pasa por riba de calquera concello que pertenza a ese territorio.
    const capasPorTerritorio = new Map<string, L.Path[]>();

    fetch("/data/concellos.geojson")
      .then((response) => response.json())
      .then((data) => {
        const capaTerritorios = L.geoJSON(data as GeoJSON.GeoJsonObject, {
          pane: "territories",
          style: (feature) => {
            const nomeConcello = feature?.properties?.CONCELLO as string | undefined;
            const territorio = nomeConcello ? territorioEfectivo(nomeConcello) : undefined;
            return territorio ? estiloBase(territorio.nome) : CONCELLO_SOLTO;
          },
          onEachFeature: (feature, layer) => {
            const nomeConcello = feature?.properties?.CONCELLO as string | undefined;
            const territorio = nomeConcello ? territorioEfectivo(nomeConcello) : undefined;
            if (!territorio || !(layer instanceof L.Path)) return;

            const grupo = capasPorTerritorio.get(territorio.nome) ?? [];
            grupo.push(layer);
            capasPorTerritorio.set(territorio.nome, grupo);

            const centrosDoTerritorio = centrosActivosPorTerritorio.get(territorio.nome) ?? [];
            const numCentros = centrosDoTerritorio.length;
            const etiqueta = territorio.nucleo ? "Núcleo" : "Territorio";
            const notaNucleo = territorio.nucleo
              ? '<p style="margin:.4rem 0 0;font-size:.72rem;color:#625f5a">Primeiro centro desta zona. Pode converterse nun territorio máis grande se se suman veciños.</p>'
              : "";
            const listaCentros = numCentros
              ? '<details style="margin-top:.5rem">' +
                  '<summary style="cursor:pointer;font-size:.72rem;font-weight:700;color:#355a2c">Ver centros</summary>' +
                  '<ul style="margin:.4rem 0 0;padding-left:1rem;font-size:.74rem;line-height:1.5;color:#3a3734">' +
                  centrosDoTerritorio
                    .map((centro) => '<li>' + centro.nome + (centro.concello === territorio.nome ? "" : ' <span style="color:#8a877f">(' + centro.concello + ')</span>') + '</li>')
                    .join("") +
                  '</ul></details>'
              : "";

            layer.bindPopup(
              '<p style="margin:0 0 .35rem;font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:' + corDoTerritorio(territorio.nome, universoTerritorios) + '">' + etiqueta + '</p>' +
              '<strong style="font-size:1rem;line-height:1.15">' + territorio.nome + '</strong>' +
              '<p style="margin:.45rem 0 0;font-size:.78rem;color:#625f5a">' + numCentros + " " + (numCentros === 1 ? "centro activo" : "centros activos") + '</p>' +
              notaNucleo +
              listaCentros,
              { maxWidth: 260 }
            );

            const realzar = () => grupo.forEach((capa) => capa.setStyle(estiloRealzado(territorio.nome)));
            const atenuar = () => grupo.forEach((capa) => capa.setStyle(estiloBase(territorio.nome)));
            layer.on("mouseover", realzar);
            layer.on("mouseout", atenuar);
            layer.on("popupclose", atenuar);
          },
        }).addTo(map);

        limitesGalicia = capaTerritorios.getBounds();
        map.setMaxBounds(limitesGalicia.pad(0.04));
        map.fitBounds(limitesGalicia);
      })
      .catch(() => undefined);

    const markerLayer = L.layerGroup().addTo(map);
    const search = document.querySelector<HTMLInputElement>("#map-search");
    const typeFilter = document.querySelector<HTMLSelectElement>("#type-filter");
    const results = document.querySelector<HTMLElement>("#map-results");

    const popup = (centro: Centro) => {
      const contacto = "contacto" in centro && centro.contacto
        ? `<a style="display:inline-block;margin-top:.7rem;font-weight:700;text-decoration:underline" href="mailto:${centro.contacto}">Contacto público</a>`
        : centro.estado === "sen_asemblea"
          ? `<a style="display:inline-block;margin-top:.7rem;font-weight:700;text-decoration:underline" href="#participa">Activar este centro</a>`
          : "";
      return `
        <p style="margin:0 0 .35rem;font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:${colors[centro.estado as Estado]}">${labels[centro.estado as Estado]}</p>
        <strong style="font-size:1rem;line-height:1.15">${centro.nome}</strong>
        <p style="margin:.45rem 0 0;font-size:.78rem;color:#625f5a">${centro.tipo} · ${centro.concello}<br>${centro.comarca}</p>
        ${contacto}
      `;
    };

    function render() {
      markerLayer.clearLayers();
      const query = search?.value.trim().toLocaleLowerCase("gl") ?? "";
      const type = typeFilter?.value ?? "";
      const visible = centros.filter((centro) => {
        const haystack = `${centro.nome} ${centro.concello} ${centro.comarca}`.toLocaleLowerCase("gl");
        const belongsToNetwork = centro.estado === "activa";
        return (query ? haystack.includes(query) : belongsToNetwork)
          && (!type || centro.tipo === type);
      });

      let soleMarker: L.CircleMarker | null = null;
      visible.forEach((centro) => {
        const marker = L.circleMarker([centro.latitude, centro.longitude], {
          pane: "overlayPane",
          radius: centro.estado === "activa" ? 7 : 5.5,
          color: "#f2f0ec",
          weight: 1.5,
          fillColor: colors[centro.estado as Estado],
          fillOpacity: .94,
        });
        marker.bindPopup(popup(centro));
        marker.addTo(markerLayer);
        if (visible.length === 1) soleMarker = marker;
      });

      if (results) {
        results.textContent = query
          ? `${visible.length} centros atopados`
          : `${visible.length} asembleas na rede`;
      }
      if (query && visible.length === 1) {
        // Única coincidencia: centramos E abrimos a súa fichiña, coma se
        // se tivese premido nela, en vez de só centrar o mapa na zona.
        map.flyTo([visible[0].latitude, visible[0].longitude], 13, { duration: .7 });
        map.once("moveend", () => soleMarker?.openPopup());
      }
    }

    [search, typeFilter].forEach((control) => {
      control?.addEventListener(control === search ? "input" : "change", render);
    });
    render();
  }
</script>
