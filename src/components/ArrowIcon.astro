---
// Frecha de liña fina para indicar "ligazón externa" ou navegación, en
// substitución dos caracteres Unicode (→, ↗, ←) que en iOS se renderizan
// coma un emoji de cores en vez de coma un símbolo de texto.
interface Props {
  direction?: "right" | "left" | "up-right";
  class?: string;
}
const { direction = "right", class: className = "" } = Astro.props;
const rotation = direction === "left" ? " rotate-180" : "";
---

{direction === "up-right" ? (
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={["inline-block h-[1em] w-[1em] align-[-0.1em]", className]}
  ><line x1="7" y1="17" x2="17" y2="7" /><polyline points="8 7 17 7 17 16" /></svg>
) : (
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={[`inline-block h-[1em] w-[1em] align-[-0.1em]${rotation}`, className]}
  ><line x1="4" y1="12" x2="20" y2="12" /><polyline points="14 6 20 12 14 18" /></svg>
)}
