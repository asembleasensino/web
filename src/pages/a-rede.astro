---
import BaseLayout from "../layouts/BaseLayout.astro";
import rede from "../data/rede.json";
import { site } from "../config/site";
import ArrowIcon from "../components/ArrowIcon.astro";
---

<BaseLayout title={`A rede · ${site.shortName}`}>
  <header class="mx-auto grid max-w-[1500px] gap-10 px-4 pb-16 pt-16 md:px-8 md:pb-24 md:pt-28 lg:grid-cols-12">
    <h1 class="display type-page-short lg:col-span-8">A rede</h1>
    <p class="max-w-md self-end text-lg leading-relaxed text-ink/70 lg:col-span-4">{rede.titulo}</p>
  </header>

  <section class="mx-auto grid max-w-[1500px] gap-12 border-t border-ink px-4 py-16 md:px-8 md:py-24 lg:grid-cols-12">
    <p class="type-intro-statement max-w-3xl font-bold leading-snug lg:col-span-7">{rede.introducion}</p>
    <div class="space-y-5 text-sm leading-relaxed text-ink/65 lg:col-span-4 lg:col-start-9">
      <p>A rede non substitúe as asembleas: conéctaas. As decisións nacen nos centros e coordínanse nas comarcas e na asemblea xeral.</p>
      <a class="inline-block border-b border-red pb-1 font-bold text-ink" href="/#mapa">Consulta o mapa da rede</a>
    </div>
  </section>

  {rede.organizacion && (
    <section class="mx-auto max-w-[1500px] border-t border-ink/20 px-4 py-16 md:px-8 md:py-20">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <h2 class="type-list-title-lg display max-w-xl">{rede.organizacion.titulo}</h2>
        {rede.organizacion.pdf && (
          <a
            href={rede.organizacion.pdf}
            download
            class="inline-flex items-center gap-1.5 text-xs font-bold text-ink/55 underline decoration-ink/25 underline-offset-4 hover:text-red hover:decoration-red"
          >
            Descargar en PDF <ArrowIcon direction="up-right" />
          </a>
        )}
      </div>

      <p class="mb-5 text-xs font-bold text-ink/40 lg:hidden">Toca cada cabeceira para pregar o grupo e cada espazo para ver máis.</p>

      <div class="redezone" id="rede-scheme">
        {rede.organizacion.grupos.map((grupo, groupIndex) => (
          <section class="redegroup">
            <button
              type="button"
              class="redegroup-toggle"
              aria-expanded="true"
              aria-controls={`rede-grupo-${groupIndex}`}
            >
              <span class="redegroup-title">{grupo.titulo}</span>
              <span class="redegroup-meta">{grupo.items.length === 1 ? "1 espazo" : `${grupo.items.length} espazos`}</span>
              <ArrowIcon direction="down" class="redegroup-chevron" />
            </button>
            <div class="redegroup-panel" id={`rede-grupo-${groupIndex}`}>
              <div class="redegroup-grid">
                {grupo.items.map((item) => (
                  <article class="scheme-card" tabindex="0">
                    <div class="scheme-head">{item.nome}</div>
                    <div class="scheme-summary">{item.texto}</div>
                    <div class="scheme-extra">
                      <div>
                        <span class="eyebrow text-red">Función</span>
                        <p>{item.funcion}</p>
                      </div>
                    </div>
                    <span class="scheme-hint" aria-hidden="true">+</span>
                  </article>
                ))}
              </div>
            </div>
          </section>
        ))}
      </div>
    </section>
  )}

  <section class="bg-ink text-paper">
    <div class="mx-auto grid max-w-[1500px] gap-14 px-4 py-20 md:px-8 md:py-28 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="display type-display-section">Grupos e comunidade</h2>
        <p class="mt-8 max-w-md text-sm leading-relaxed text-paper/65">{rede.textoWhatsapp}</p>
        {rede.comunidadeWhatsapp && (
          <a class="mt-8 inline-block rounded-[4px] bg-paper px-5 py-4 text-xs font-black uppercase tracking-wider text-ink" href={rede.comunidadeWhatsapp}>Entrar na comunidade</a>
        )}
      </div>
      <div class="lg:col-span-7 lg:pt-16">
        {rede.grupos.map((grupo) => (
          <article class="grid gap-3 border-t border-paper/25 py-5 last:border-b sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-5">
            <h3 class="text-xl font-bold">{grupo.nome}</h3>
            <div class="flex flex-wrap gap-x-5 gap-y-2 text-xs font-bold uppercase tracking-wider text-paper/65">
              {grupo.whatsapp ? <a class="text-paper inline-flex items-center gap-1.5" href={grupo.whatsapp}>WhatsApp <ArrowIcon direction="up-right" /></a> : <span>Ligazón pendente</span>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1500px] gap-12 px-4 py-20 md:px-8 md:py-28 lg:grid-cols-12">
    <h2 class="display type-display-section-lg lg:col-span-5">Coidar os espazos</h2>
    <ol class="border-t border-ink lg:col-span-7 lg:mt-16">
      {rede.normas.map((norma, index) => (
        <li class="grid grid-cols-[3rem_1fr] gap-5 border-b border-ink/25 py-6">
          <span class="text-xs text-ink/35">0{index + 1}</span>
          <p class="text-lg font-bold leading-snug">{norma}</p>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .redezone {
    --line: color-mix(in srgb, var(--color-ink) 15%, transparent);
    --muted: color-mix(in srgb, var(--color-ink) 55%, transparent);
    --card: color-mix(in srgb, var(--color-ink) 2%, var(--color-paper));
    --green-dark: color-mix(in srgb, var(--color-green) 78%, black);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .redegroup-toggle {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 16px;
    border: none;
    border-radius: 4px;
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 20px 22px;
    text-align: left;
    cursor: pointer;
    box-shadow: var(--shadow-hard-sm);
    transition: transform .15s ease, box-shadow .15s ease;
  }

  .redegroup-toggle:hover,
  .redegroup-toggle:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard);
  }

  .redegroup-toggle:focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: 3px;
  }

  .redegroup-title {
    flex: 1;
    font-family: var(--font-display);
    font-stretch: condensed;
    text-transform: uppercase;
    letter-spacing: -.01em;
    font-weight: 900;
    line-height: 1.1;
    font-size: clamp(1.1rem, 1.9vw, 1.55rem);
  }

  .redegroup-meta {
    font-size: .68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: color-mix(in srgb, var(--color-paper) 55%, transparent);
    white-space: nowrap;
  }

  .redegroup-chevron {
    flex-shrink: 0;
    width: 1.1em;
    height: 1.1em;
    transition: transform .25s ease, color .15s ease;
  }

  .redegroup-toggle:hover .redegroup-chevron,
  .redegroup-toggle:focus-visible .redegroup-chevron {
    color: var(--color-red);
  }

  .redegroup.is-collapsed .redegroup-chevron {
    transform: rotate(-90deg);
  }

  .redegroup-panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows .3s ease;
  }

  .redegroup.is-collapsed .redegroup-panel {
    grid-template-rows: 0fr;
  }

  .redegroup-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    padding-top: 14px;
    overflow: hidden;
    min-height: 0;
  }

  .scheme-card {
    position: relative;
    min-height: 280px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    outline: none;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease, opacity .2s ease;
  }

  .redezone.has-active .scheme-card:not(.is-active) { opacity: .5; }

  .scheme-card:hover,
  .scheme-card:focus-visible,
  .scheme-card.is-active {
    transform: translate(-3px, -3px);
    border-color: var(--color-ink);
    box-shadow: var(--shadow-hard);
    z-index: 2;
  }

  .scheme-head {
    min-height: 88px;
    padding: 16px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--color-green);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-stretch: condensed;
    text-transform: uppercase;
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -.01em;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    transition: background .2s ease;
  }

  .scheme-card:hover .scheme-head,
  .scheme-card:focus-visible .scheme-head,
  .scheme-card.is-active .scheme-head {
    background: var(--green-dark);
  }

  .scheme-summary {
    padding: 20px 20px 20px;
    text-align: center;
    line-height: 1.55;
    font-size: .92rem;
    color: var(--muted);
    transition: opacity .2s ease, transform .2s ease;
  }

  .scheme-extra {
    position: absolute;
    inset: 88px 0 0 0;
    background: color-mix(in srgb, var(--color-paper) 97%, var(--color-ink));
    padding: 24px 22px 22px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity .2s ease, transform .2s ease;
  }

  .scheme-extra > div { display: flex; flex-direction: column; gap: 10px; }

  .scheme-extra p {
    margin: 0;
    font-size: .9rem;
    line-height: 1.55;
    text-align: left;
    color: var(--color-ink);
  }

  .scheme-card:hover .scheme-extra,
  .scheme-card:focus-visible .scheme-extra,
  .scheme-card.is-active .scheme-extra {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .scheme-card:hover .scheme-summary,
  .scheme-card:focus-visible .scheme-summary,
  .scheme-card.is-active .scheme-summary {
    opacity: 0;
    transform: translateY(-4px);
  }

  .scheme-hint {
    position: absolute;
    right: 12px;
    bottom: 10px;
    width: 26px;
    height: 26px;
    border: 1px solid var(--line);
    border-radius: 999px;
    display: grid;
    place-items: center;
    color: var(--muted);
    background: color-mix(in srgb, var(--color-paper) 70%, transparent);
    font-size: .95rem;
    font-weight: 700;
    transition: transform .2s ease, border-color .2s ease, color .2s ease;
    z-index: 3;
  }

  .scheme-card:hover .scheme-hint,
  .scheme-card:focus-visible .scheme-hint,
  .scheme-card.is-active .scheme-hint {
    transform: rotate(45deg);
    color: var(--color-paper);
    border-color: var(--color-paper);
  }

  @media (max-width: 1024px) {
    .redegroup-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .scheme-card { min-height: 250px; }
  }

  @media (max-width: 640px) {
    .redegroup-toggle { padding: 16px 16px; gap: 12px; }
    .redegroup-meta { display: none; }

    .redegroup-grid {
      grid-template-columns: 1fr;
      gap: 8px;
      padding-top: 8px;
    }

    .scheme-card {
      min-height: 0;
      transform: none !important;
      box-shadow: none !important;
    }

    .redezone.has-active .scheme-card:not(.is-active) { opacity: 1; }

    .scheme-head {
      min-height: 0;
      padding: 14px 44px 14px 16px;
      justify-content: flex-start;
      text-align: left;
      font-size: 1rem;
    }

    .scheme-summary {
      padding: 14px 44px 15px 16px;
      text-align: left;
    }

    .scheme-extra {
      position: static;
      display: grid;
      grid-template-rows: 0fr;
      padding: 0 16px;
      opacity: 1;
      transform: none;
      pointer-events: none;
      background: color-mix(in srgb, var(--color-ink) 4%, var(--color-paper));
      transition: grid-template-rows .25s ease, padding .25s ease;
    }

    .scheme-extra > div { overflow: hidden; }

    .scheme-card.is-active .scheme-extra {
      grid-template-rows: 1fr;
      padding: 14px 16px;
      pointer-events: auto;
    }

    .scheme-card.is-active .scheme-summary { opacity: 1; transform: none; }

    .scheme-hint {
      top: 12px;
      right: 12px;
      bottom: auto;
      color: var(--color-paper);
      border-color: color-mix(in srgb, var(--color-paper) 55%, transparent);
      background: color-mix(in srgb, var(--color-paper) 15%, transparent);
    }

    .scheme-card.is-active .scheme-hint {
      color: var(--color-paper);
      border-color: color-mix(in srgb, var(--color-paper) 70%, transparent);
    }
  }

  @media (hover: none) {
    .scheme-card:hover .scheme-extra { opacity: 0; transform: translateY(10px); pointer-events: none; }
    .scheme-card:hover .scheme-summary { opacity: 1; transform: none; }
    .scheme-card:hover .scheme-head { background: var(--color-green); }
    .scheme-card.is-active .scheme-extra { opacity: 1; transform: none; pointer-events: auto; }
    .scheme-card.is-active .scheme-head { background: var(--green-dark); }
    .redegroup-toggle:hover { transform: none; box-shadow: var(--shadow-hard-sm); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scheme-card, .scheme-head, .scheme-summary, .scheme-extra, .scheme-hint,
    .redegroup-toggle, .redegroup-chevron, .redegroup-panel { transition: none; }
  }
</style>

<script>
  const scheme = document.getElementById("rede-scheme");
  const cards = scheme ? [...scheme.querySelectorAll<HTMLElement>(".scheme-card")] : [];
  const mobileQuery = window.matchMedia("(max-width: 640px), (hover: none)");

  function closeAllCards(except: HTMLElement | null = null) {
    for (const card of cards) {
      if (card !== except) card.classList.remove("is-active");
    }
    scheme?.classList.toggle("has-active", Boolean(except?.classList.contains("is-active")));
  }

  function toggleCard(card: HTMLElement) {
    const opening = !card.classList.contains("is-active");
    closeAllCards();
    if (opening) {
      card.classList.add("is-active");
      scheme?.classList.add("has-active");
    }
  }

  for (const card of cards) {
    card.addEventListener("click", () => {
      if (!mobileQuery.matches) return;
      toggleCard(card);
    });
    card.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggleCard(card);
      }
    });
  }

  document.addEventListener("click", (event) => {
    if (mobileQuery.matches && !(event.target as HTMLElement).closest(".scheme-card")) {
      closeAllCards();
    }
  });

  const groups = scheme ? [...scheme.querySelectorAll<HTMLElement>(".redegroup")] : [];
  for (const group of groups) {
    const toggle = group.querySelector<HTMLElement>(".redegroup-toggle");
    toggle?.addEventListener("click", () => {
      const collapsed = group.classList.toggle("is-collapsed");
      toggle.setAttribute("aria-expanded", String(!collapsed));
    });
  }
</script>
