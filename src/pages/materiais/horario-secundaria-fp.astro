/* Safety patches on top of the ported design:
   - .card-title: with 4 columns (vs. 3 on the Infantil/Primaria page) and the
     site's Arial Narrow fallback (wider than the mockup's unloaded "Druk
     Condensed"), long single-word titles like "COMPLEMENTARIAS" or
     "PERMANENCIA" overflowed their card and got clipped by .hour-card's
     overflow:hidden. Shrink the size for this narrower layout and add a
     word-break fallback so a title can never render invisibly.
   - .exception-card ul / .assignment-box ul: the site's Tailwind reset
     zeroes out list-style, so these lists lost their bullet marker once
     embedded here. Restore it to match the original design. */
.card-title{font-size:clamp(1.05rem,1.55vw,1.55rem);min-height:64px;overflow-wrap:break-word}
.exception-card ul,.assignment-box ul{list-style:disc}

/* Astro's CSS scoping only tags elements that exist in this file's static
   template with the data-astro-cid attribute the scoped rules key off. The
   #dynamicChecks / #regimeBox contents are built at runtime by the plain
   ported <script> via innerHTML, so those elements never receive that
   attribute and the (identical, already-defined-above) scoped .check /
   .check-mark / .check-detail / .regime-box rules silently never match them.
   Re-declare just the runtime-generated pieces as :global() so they apply. */
:global(.check){display:grid;grid-template-columns:24px 1fr auto;gap:10px;align-items:start;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.10);font-size:.92rem}
:global(.check-mark){width:20px;height:20px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.08);font-size:.7rem;margin-top:1px}
:global(.check.ok .check-mark){background:#315b46}
:global(.check.bad .check-mark){background:#7b3330}
:global(.check.warn .check-mark){background:#785a28}
:global(.check .expected){color:rgba(255,255,255,.46);font-size:.78rem;text-align:right}
:global(.check-detail){display:block;color:rgba(255,255,255,.45);font-size:.74rem;line-height:1.35;margin-top:3px}
:global(.regime-box strong){display:block;color:#f0a19b;font-size:1.1rem}
:global(.regime-box span){display:block;margin-top:6px;color:rgba(255,255,255,.64);font-size:.8rem;line-height:1.4}

/* "Secundaria" (10 letters, no space to wrap at) is longer than any single
   word in the Infantil/Primaria heading and still overflowed its own line
   at the existing @620px h1 size on a real phone width — reduce further. */
@media(max-width:620px){
  h1{font-size:clamp(2.4rem,13.5vw,4.2rem)}
  /* Same overflow, this time on "COORDINACIÓNS" (13 letters) inside the
     "Cargos e coordinacións" section-title, which had no mobile override
     at all in the original. */
  .section-title{font-size:clamp(1.9rem,10vw,3rem)}
}
</style>

<script is:inline>

  const $ = id => document.getElementById(id);
  const num = id => {
    const v = parseFloat($(id).value);
    return Number.isFinite(v) ? v : 0;
  };

  function selectedRoles(){
    return [...document.querySelectorAll('#coordGrid input[type="checkbox"]:checked')];
  }

  function addCheck(list,state,title,detail=''){
    list.push({state,title,detail});
  }

  function renderChecks(items){
    $('dynamicChecks').innerHTML = items.map(i => `
      <div class="check ${i.state}">
        <span class="check-mark">${i.state==='ok'?'✓':i.state==='warn'?'!':'×'}</span>
        <span>${i.title}${i.detail?`<small class="check-detail">${i.detail}</small>`:''}</span>
        <span class="expected"></span>
      </div>`).join('');
  }

  function update(){
    $('xefaturaGrandeWrap').classList.toggle('hidden-field', $('xefatura').value !== 'grande');

    const roles = selectedRoles();
    const rolesLect = roles.reduce((s,e)=>s+Number(e.dataset.lect||0),0);
    const rolesMinFix = roles.reduce((s,e)=>s+Number(e.dataset.minfix||0),0);
    const rolesNeedUnspecFix = roles.some(e=>e.dataset.unspecfix==='1');

    let xefLect=0, xefFix=0;
    if($('xefatura').value==='normal') xefLect=1;
    if($('xefatura').value==='uni') xefFix=1;
    if($('xefatura').value==='grande') xefLect=num('xefaturaGrandeLect');

    const titorLect = $('titor').checked ? 1 : 0;
    const directivoLect = num('directivoLect');
    const lect = num('docencia') + titorLect + xefLect + rolesLect + directivoLect;

    const fixedExtraAuto = ($('participaBilingue').checked ? 1 : 0) + xefFix;
    const fixed = num('gardas') + num('familias') + num('coordFixas') + num('outrasFixas') + fixedExtraAuto;

    $('lectTotal').textContent = lect;
    $('fixTotal').textContent = fixed;

    const checks=[];
    let targetFix=null;
    if(lect===18) targetFix=5;
    else if(lect===19) targetFix=2;
    else if(lect===20) targetFix=0;

    if(lect<18){
      addCheck(checks,'bad','Faltan sesións na parte lectiva',`${lect}/18. A regra xeral é completar 18 sesións lectivas.`);
    }else if(lect===18){
      addCheck(checks,'ok','Parte lectiva ordinaria completa','18 sesións.');
    }else if(lect===19 || lect===20){
      addCheck(checks,$('inspeccion').checked?'ok':'bad',`Horario excepcional de ${lect} lectivas`,
        $('inspeccion').checked ? 'Marcaches autorización de Inspección.' : 'A resolución esixe autorización do Servizo Territorial de Inspección Educativa.');
    }else{
      addCheck(checks,'bad','Excedes o máximo excepcional','A resolución permite excepcionalmente un máximo de 20 sesións lectivas.');
    }

    if(num('afinsSes') > num('docencia')){
      addCheck(checks,'bad','As materias afíns superan a docencia directa introducida','Revisa os datos.');
    }

    if(lect>18 && num('afinsSes')>0){
      addCheck(checks,$('conformidadeAfins').checked?'ok':'bad','Materias afíns por riba de 18',
        $('conformidadeAfins').checked ? 'Consta conformidade do profesorado afectado.' : 'Para superar 18 con materias afíns é necesaria a conformidade do profesorado afectado.');
    }

    if(targetFix!==null){
      addCheck(checks,fixed===targetFix?'ok':'bad','Complementarias fixas',
        `${fixed}/${targetFix}. ${lect===18?'Modelo ordinario: 5.':lect===19?'Con 19 lectivas: 2.':'Con 20 lectivas: 0.'}`);
    }

    if(lect===18 || lect===19){
      addCheck(checks,num('familias')===1?'ok':'bad','Atención a familias/alumnado',
        lect===18 ? 'No modelo ordinario, unha das 5 complementarias fixas é esta sesión.' : 'Con 19 lectivas, unha das 2 complementarias fixas debe ser esta sesión.');
    }else if(lect===20){
      addCheck(checks,num('familias')===0?'ok':'bad','Con 20 lectivas non hai complementaria fixa de familias',
        'A resolución pasa esta atención á parte complementaria non fixa: 6 sesións, unha delas para familias/alumnado.');
    }

    const minRequired = rolesMinFix + fixedExtraAuto;
    if(num('coordFixas') + fixedExtraAuto < minRequired){
      addCheck(checks,'bad','Faltan complementarias fixas vinculadas ás funcións',
        `As funcións marcadas esixen polo menos ${minRequired} sesión(s) fixas computables entre coordinacións, xefatura unipersoal e participación bilingüe.`);
    }else if(minRequired>0){
      addCheck(checks,'ok','Mínimos fixos das funcións con número expreso cubertos',`Mínimo comprobable: ${minRequired}.`);
    }

    if(rolesNeedUnspecFix || $('formacionProf').checked || $('consello').checked){
      addCheck(checks,'warn','Hai funcións con complementarias fixas que a resolución non cuantifica',
        'A dirección do centro debe determinar cantas se asignan. O comprobador non inventa ese número.');
    }

    const responsibilities = roles.length + ($('titor').checked?1:0) + ($('xefatura').value!=='none'?1:0) + (directivoLect>0?1:0);
    if(responsibilities>=3){
      addCheck(checks,'warn','Acumulación de responsabilidades',
        'A resolución pide unha distribución equilibrada e evitar acumulacións; en circunstancias organizativas xustificadas Inspección pode autorizar excepcionalmente a acumulación.');
    }

    if(lect===19 || lect===20){
      addCheck(checks,'warn','Comproba a causa da excepcionalidade',
        'As 19/20 lectivas están previstas cando a distribución horaria das materias propias do departamento o requira.');
    }

    renderChecks(checks);

    const bad = checks.some(i=>i.state==='bad');
    const warn = checks.some(i=>i.state==='warn');
    $('stateDot').className = 'state-dot ' + (bad?'bad':warn?'warn':'ok');
    $('resultTitle').textContent = bad ? 'Hai puntos que non encaixan' : warn ? 'Encaixa, con aspectos a confirmar' : 'O horario encaixa co modelo';

    let regime='';
    if(lect===18){
      regime='<strong>Modelo ordinario · 18 + 5</strong><span>18 lectivas + 5 complementarias fixas. Ademais, o réxime semanal inclúe 7 h de permanencia non fixa + 7,5 h de non obrigada permanencia no centro.</span>';
    }else if(lect===19){
      regime='<strong>Excepción · 19 + 2</strong><span>19 lectivas + 2 complementarias fixas, unha delas para atención a familias/alumnado, con autorización de Inspección.</span>';
    }else if(lect===20){
      regime='<strong>Máximo excepcional · 20 + 0</strong><span>20 lectivas + 0 complementarias fixas. A parte complementaria non fixa pasa a 6 sesións, unha delas para atención a familias/alumnado.</span>';
    }else{
      regime='<strong>Referencia normativa</strong><span>A parte lectiva ordinaria é de 18 sesións; excepcionalmente pode chegar a 20 nas condicións previstas na resolución.</span>';
    }
    $('regimeBox').innerHTML = regime;
  }

  document.querySelectorAll('#simulador input,#simulador select').forEach(el=>{
    el.addEventListener('input',update);
    el.addEventListener('change',update);
  });
  update();
</script>
