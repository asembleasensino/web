---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import { site } from "../../config/site";

const title = `Horario · Secundaria e FP · Materiais · ${site.shortName}`;
const description = "Resumo visual e comprobador interactivo do horario semanal do persoal docente de secundaria, bacharelato, FP e réxime especial, segundo a Resolución do 16 de xuño de 2026.";
---

<BaseLayout title={title} description={description}>
<article class="page"> <section class="hero"> <div><h1 class="display">Horario<br>Secundaria e FP</h1></div> <div class="hero-copy"><div class="kicker">Como se reparte a xornada</div><p class="intro">Resumo visual da <strong><a class="norm-link" href="https://www.edu.xunta.gal/portal/sites/web/files/resolucion_instrucions_xornada_de_traballo_docente_2026_2027_sin.pdf" target="_blank" rel="noopener noreferrer">Resolución do 16 de xuño de 2026</a></strong> para educación básica de persoas adultas, ESO, bacharelato, formación profesional, ensinanzas artísticas, de idiomas e deportivas. A xornada total é de <strong>37,5 horas semanais</strong>, cunha parte fixa expresada en sesións e outra en horas.</p></div> </section>  <section class="total-strip" aria-label="Distribución xeral da xornada"> <div class="sum-part"><span class="sum-label">Lectivas fixas</span><strong class="sum-value display">18 ses.</strong></div><div class="operator">+</div> <div class="sum-part"><span class="sum-label">Complementarias fixas</span><strong class="sum-value display">5 ses.</strong></div><div class="operator">+</div> <div class="sum-part"><span class="sum-label">Permanencia non fixa</span><strong class="sum-value display">7 h</strong></div><div class="operator">+</div> <div class="sum-part"><span class="sum-label">Non obrigada permanencia</span><strong class="sum-value display">7,5 h</strong></div><div class="operator">=</div> <div class="sum-total"><span class="sum-label">Xornada semanal total</span><strong class="sum-value display">37,5 h</strong><small>As 23 sesións fixas teñen a duración dos períodos lectivos establecidos para cada centro/ensinanza no curso 2025/26.</small></div> </section>  <section class="hours-grid"> <article class="hour-card"><h2 class="card-title display">Lectivas<br>fixas</h2><div class="mini-label">Número</div><div class="big-hours display">18 sesións</div><div class="mini-label">Docencia directa</div><div class="functions"> <div class="function-item"><span class="function-icon">MA</span><div class="function-copy">Materias, ámbitos, disciplinas e/ou módulos da especialidade.</div></div> <div class="function-item"><span class="function-icon">TU</span><div class="function-copy">Titoría presencial co alumnado do grupo, de ser o caso.</div></div> <div class="function-item"><span class="function-icon">AF</span><div class="function-copy">Materias afíns.</div></div> <div class="function-item"><span class="function-icon">PT</span><div class="function-copy">Intervención directa de PT e Audición e Linguaxe.</div></div> <div class="function-item"><span class="function-icon">OR</span><div class="function-copy">Funcións propias de Orientación Educativa.</div></div> <div class="function-item"><span class="function-icon">CO</span><div class="function-copy">Apoio, codocencia e desdobramentos.</div></div> </div></article>  <article class="hour-card"><h2 class="card-title display">Complementarias<br>fixas</h2><div class="mini-label">Número</div><div class="big-hours display">5 sesións</div><div class="mini-label">Distribución ordinaria</div><div class="functions"> <div class="function-item"><span class="function-icon">1</span><div class="function-copy"><strong>1 sesión</strong> de titoría para atención a familias e alumnado; se non hai citas, a dirección pode asignar outra función non lectiva.</div></div> <div class="function-item"><span class="function-icon">4</span><div class="function-copy"><strong>4 sesións</strong> para gardas e/ou outras funcións non lectivas que determine a dirección.</div></div> <div class="function-item"><span class="function-icon">GA</span><div class="function-copy">Gardas ordinarias, de recreo e de transporte computan aquí.</div></div> <div class="function-item"><span class="function-icon">TR</span><div class="function-copy">A garda de transporte dura o tempo imprescindible entre transporte e actividade lectiva.</div></div> </div></article>  <article class="hour-card"><h2 class="card-title display">Permanencia<br>non fixa</h2><div class="mini-label">Número</div><div class="big-hours display">7 horas</div><div class="mini-label">Principalmente para</div><div class="functions"> <div class="function-item"><span class="function-icon">RE</span><div class="function-copy">Reunións de departamento, equipos docentes, equipo directivo, órganos colexiados e coordinación.</div></div> <div class="function-item"><span class="function-icon">AV</span><div class="function-copy">Avaliacións e coordinación pedagóxica.</div></div> <div class="function-item"><span class="function-icon">PR</span><div class="function-copy">Protocolos educativos, titorías, orientación e proxectos.</div></div> <div class="function-item"><span class="function-icon">TA</span><div class="function-copy">Laboratorios, talleres, prácticas, actividades complementarias e extraescolares.</div></div> <div class="function-item"><span class="function-icon">FP</span><div class="function-copy">Formación, mentoría, FCT/prácticas en empresas e relación con axentes externos.</div></div> </div></article>  <article class="hour-card"><h2 class="card-title display">Non obrigada<br>permanencia</h2><div class="mini-label">Número</div><div class="big-hours display">7,5 horas</div><div class="mini-label">A que se destinan</div><div class="functions"> <div class="function-item"><span class="function-icon">FO</span><div class="function-copy">Perfeccionamento e formación.</div></div> <div class="function-item"><span class="function-icon">PR</span><div class="function-copy">Preparación de actividades docentes.</div></div> <div class="function-item"><span class="function-icon">OU</span><div class="function-copy">Outras actividades inherentes á función docente.</div></div> </div></article> </section>  <section class="practical" aria-label="Regra práctica do horario"> <div class="practical-label"> <div> <div class="practical-eyebrow">Lectura rápida do modelo</div> <div class="main display">Regra<br>práctica</div> </div> </div> <div class="practical-content"> <div class="practical-text"> O punto de partida é <strong>18 sesións lectivas + 5 complementarias fixas</strong>.
        As <strong>19 ou 20 lectivas</strong> son configuracións excepcionais: deben responder á distribución horaria das materias do departamento e precisan autorización do Servizo Territorial de Inspección Educativa. </div> <div class="practical-models" aria-label="Modelos de distribución"> <div class="model-pill primary"><span>Ordinario</span><b>18 + 5</b></div> <div class="model-pill exception"><span>Excepcional</span><b>19 + 2</b></div> <div class="model-pill exception"><span>Máximo</span><b>20 + 0</b></div> </div> <div class="practical-source">Fonte: <a href="https://www.edu.xunta.gal/portal/sites/web/files/resolucion_instrucions_xornada_de_traballo_docente_2026_2027_sin.pdf" target="_blank" rel="noopener noreferrer">Resolución do 16 de xuño de 2026 · Xunta de Galicia <ArrowIcon direction="up-right" /></a></div> </div> </section>  <section class="exceptions"> <div class="section-kicker">Excepción ao modelo ordinario</div><h2 class="section-title display">Cando se supera<br>18 lectivas</h2> <div class="exception-grid"> <article class="exception-card"><div class="exception-num display">18</div><h3>Modelo ordinario</h3><p><strong>18 sesións lectivas + 5 complementarias fixas.</strong></p><ul><li>1 fixa para atención a familias/alumnado.</li><li>4 fixas para gardas ou outras funcións non lectivas.</li></ul></article> <article class="exception-card"><div class="exception-num display">19</div><h3>Excepcional</h3><p><strong>19 lectivas + 2 complementarias fixas.</strong></p><ul><li>Unha das dúas fixas será a titoría de atención a familias/alumnado.</li><li>Se o exceso deriva de materias afíns, require conformidade do profesorado afectado.</li></ul></article> <article class="exception-card"><div class="exception-num display">20</div><h3>Máximo excepcional</h3><p><strong>20 lectivas + 0 complementarias fixas.</strong></p><ul><li>A parte complementaria non fixa pasa a <strong>6 sesións</strong>.</li><li>Unha delas será a titoría de atención a familias/alumnado.</li><li>Require autorización de Inspección.</li></ul></article> </div> </section>  <section class="rules"> <h2 class="display">A ter<br>en conta</h2> <div class="rule-list"> <div class="norm-rule"><b>01</b><div>A codocencia é a intervención simultánea de dous docentes na mesma sesión lectiva e non implica cotitularidade nin responsabilidade compartida na programación, seguimento ou avaliación.</div></div> <div class="norm-rule"><b>02</b><div>Apoios, codocencia e desdobres deben priorizar grupos numerosos, espazos singulares (aulas-taller, laboratorios…) e grupos cunha maior proporción de alumnado con necesidades específicas de apoio educativo.</div></div> <div class="norm-rule"><b>03</b><div>As actividades de permanencia non fixa debidamente convocadas —incluídas as telemáticas— teñen asistencia obrigatoria e efectos no cómputo de faltas e permisos.</div></div> <div class="norm-rule"><b>04</b><div>O profesorado titor de ESO, FPB, Bacharelato e FP en IES e CPI dispón de <strong>1 sesión de titoría sen alumnado</strong> que conta na parte lectiva.</div></div> <div class="norm-rule"><b>05</b><div>Se non hai horario lectivo completo da especialidade, pódese completar noutro centro da mesma localidade ou no propio mediante materias afíns, apoio e/ou codocencia.</div></div> <div class="norm-rule"><b>06</b><div>Os centros deben procurar unha distribución equilibrada das responsabilidades. A acumulación excepcional de cargos/funcións pode ser autorizada por Inspección se non implica incremento de profesorado.</div></div> </div> </section>  <section class="assignments"> <div class="section-kicker">Asignacións horarias que poden alterar a composición das 18 lectivas</div><h2 class="section-title display">Cargos e<br>coordinacións</h2> <div class="assignment-grid"> <article class="assignment-box"><h3>Xefaturas de departamento</h3><ul><li>Departamento unipersoal: <strong>1 complementaria fixa</strong>.</li><li>Resto: <strong>1 sesión lectiva semanal</strong> + complementarias fixas que determine o centro.</li><li>Departamentos de 15 ou máis membros: asignación segundo criterios obxectivos fixados pola dirección.</li></ul></article> <article class="assignment-box"><h3>Titorías</h3><p>ESO, FPB, Bacharelato e FP en IES/CPI: <strong>1 sesión de titoría sen alumnado con cómputo lectivo.</strong></p></article> <article class="assignment-box"><h3>Coordinacións con 2 lectivas</h3><p><strong>Convivencia e benestar:</strong> 2 lectivas + complementarias fixas que determine a dirección, cun mínimo de dúas.</p></article> <article class="assignment-box"><h3>Coordinacións con 1 lectiva</h3><p>Programas/centros plurilingües, seccións bilingües, biblioteca PLAMBE/non PLAMBE, dinamización da lingua galega, TIC, E-Dixgal (>150 alumnado no programa), Polos Creativos, STEMBACH, programas internacionais, Club de Ciencias, FCT e actividades complementarias/extraescolares en centros sen vicedirección.</p></article> <article class="assignment-box"><h3>Complementarias fixas</h3><p>Profesorado participante en sección bilingüe: 1 fixa. Formación do profesorado e representantes no Consello Escolar: as que determine a dirección. Equipos colaboradores de biblioteca/TIC poden recibir complementarias fixas.</p></article> <article class="assignment-box"><h3>Autonomía do centro</h3><p>As sesións complementarias fixas determínanse con criterios obxectivos e organizativos, buscando equilibrio de responsabilidades e cobertura de gardas. Centros con alta oferta de FP teñen autonomía adicional para adaptar estas asignacións ás necesidades das ensinanzas.</p></article> </div> </section>  <section class="simulator" id="simulador"> <div class="sim-head"> <div> <div class="sim-eyebrow">Ferramenta orientativa</div> <h2 class="sim-title display">Comproba<br>o teu horario</h2> </div> <p class="sim-desc"> Introduce <strong>o que realmente tes asignado</strong>: docencia, titoría, xefaturas,
        coordinacións, cargo directivo e gardas. O comprobador traduce esas funcións ás categorías
        da <a class="norm-link" href="https://www.edu.xunta.gal/portal/sites/web/files/resolucion_instrucions_xornada_de_traballo_docente_2026_2027_sin.pdf" target="_blank" rel="noopener noreferrer">Resolución do 16 de xuño de 2026</a>. </p> </div>  <div class="sim-body"> <div class="sim-form">  <div class="sim-block"> <div class="sim-block-title"><span>1</span> Docencia directa</div> <div class="sim-help compact">Inclúe clases, titoría presencial co grupo, materias afíns, PT/AL, orientación, apoio, codocencia e desdobres.</div> <div class="field-grid"> <div class="field"> <label for="docencia">Sesións de docencia directa</label> <div class="input-wrap"><input id="docencia" type="number" min="0" step="1" value="17"><span>ses.</span></div> </div> <div class="field"> <label for="afinsSes">Destas, materias afíns</label> <div class="input-wrap"><input id="afinsSes" type="number" min="0" step="1" value="0"><span>ses.</span></div> </div> </div> </div>  <div class="sim-block"> <div class="sim-block-title"><span>2</span> Funcións con cómputo lectivo</div> <div class="choice-row"> <label class="choice"><input id="titor" type="checkbox" checked><span><b>Titor/a de grupo</b><small>ESO, FPB, Bacharelato ou FP en IES/CPI: +1 sesión lectiva sen alumnado.</small></span></label> </div>  <div class="field" style="margin-top:16px"> <label for="xefatura">Xefatura de departamento</label> <div class="input-wrap select-wrap"><select id="xefatura"> <option value="none">Non</option> <option value="uni">Departamento unipersoal · +1 complementaria fixa</option> <option value="normal">Departamento ordinario · +1 lectiva</option> <option value="grande">Departamento de 15 ou máis membros · asignación da dirección</option> </select></div> </div> <div id="xefaturaGrandeWrap" class="field hidden-field" style="margin-top:12px"> <label for="xefaturaGrandeLect">Sesións lectivas asignadas pola dirección</label> <div class="input-wrap"><input id="xefaturaGrandeLect" type="number" min="0" step="1" value="1"><span>ses.</span></div> </div>  <div class="coord-grid" id="coordGrid"> <label class="coord"><input type="checkbox" data-name="Convivencia e benestar" data-lect="2" data-minfix="2"><span>Convivencia e benestar</span><b>+2 L · ≥2 CF</b></label> <label class="coord"><input type="checkbox" data-name="Programas plurilingües" data-lect="1"><span>Programas plurilingües</span><b>+1 L</b></label> <label class="coord"><input type="checkbox" data-name="Centro plurilingüe" data-lect="1" data-unspecfix="1"><span>Centro plurilingüe</span><b>+1 L + CF</b></label> <label class="coord"><input type="checkbox" data-name="Sección bilingüe" data-lect="1" data-unspecfix="1"><span>Coord. sección bilingüe</span><b>+1 L + CF</b></label> <label class="coord"><input type="checkbox" data-name="Biblioteca PLAMBE" data-lect="1" data-unspecfix="1"><span>Biblioteca PLAMBE</span><b>+1 L + CF</b></label> <label class="coord"><input type="checkbox" data-name="Biblioteca non PLAMBE" data-lect="1" data-unspecfix="1"><span>Biblioteca non PLAMBE</span><b>+1 L + CF</b></label> <label class="coord"><input type="checkbox" data-name="Dinamización lingua galega" data-lect="1" data-minfix="2"><span>Dinamización lingua galega</span><b>+1 L · ≥2 CF</b></label> <label class="coord"><input type="checkbox" data-name="TIC" data-lect="1" data-unspecfix="1"><span>Coordinación TIC</span><b>+1 L + CF</b></label> <label class="coord"><input type="checkbox" data-name="E-Dixgal" data-lect="1" data-unspecfix="1"><span>Coordinación E-Dixgal &gt;150</span><b>+1 L + CF</b></label> <label class="coord"><input type="checkbox" data-name="Polos Creativos" data-lect="1" data-unspecfix="1"><span>Polos Creativos</span><b>+1 L + CF</b></label> <label class="coord"><input type="checkbox" data-name="STEMBACH" data-lect="1" data-unspecfix="1"><span>STEMBACH</span><b>+1 L + CF</b></label> <label class="coord"><input type="checkbox" data-name="Programas internacionais" data-lect="1" data-unspecfix="1"><span>Programas internacionais</span><b>+1 L + CF</b></label> <label class="coord"><input type="checkbox" data-name="Club de Ciencias" data-lect="1" data-unspecfix="1"><span>Club de Ciencias</span><b>+1 L + CF</b></label> <label class="coord"><input type="checkbox" data-name="Actividades complementarias/extraescolares" data-lect="1" data-minfix="2"><span>Activ. complementarias/extraescolares (sen vicedirección)</span><b>+1 L · +2 CF</b></label> <label class="coord"><input type="checkbox" data-name="FCT" data-lect="1" data-unspecfix="1"><span>Coordinación FCT</span><b>+1 L + CF</b></label> </div>  <div class="choice-row stacked"> <label class="choice"><input id="participaBilingue" type="checkbox"><span><b>Participante nunha sección bilingüe</b><small>+1 complementaria fixa.</small></span></label> <label class="choice"><input id="formacionProf" type="checkbox"><span><b>Coordinación de formación do profesorado</b><small>Complementarias fixas a determinar pola dirección.</small></span></label> <label class="choice"><input id="consello" type="checkbox"><span><b>Representante no Consello Escolar</b><small>Complementarias fixas a determinar pola dirección.</small></span></label> </div> </div>  <div class="sim-block"> <div class="sim-block-title"><span>3</span> Cargo directivo, se procede</div> <div class="sim-help compact">Introduce as sesións lectivas efectivamente asignadas ao cargo. A resolución fixa máximos segundo centro/cargo, non unha cantidade obrigatoria única.</div> <div class="field"> <label for="directivoLect">Sesións lectivas dedicadas ao cargo</label> <div class="input-wrap"><input id="directivoLect" type="number" min="0" step="1" value="0"><span>ses.</span></div> </div> </div>  <div class="sim-block"> <div class="sim-block-title"><span>4</span> Complementarias fixas do horario</div> <div class="sim-help compact">Introduce de que están feitas. Non escribas “5” por defecto: o comprobador suma gardas, atención a familias e as complementarias asignadas ás túas funcións.</div> <div class="field-grid"> <div class="field"> <label for="gardas">Gardas / recreos / transporte</label> <div class="input-wrap"><input id="gardas" type="number" min="0" step="1" value="4"><span>ses.</span></div> </div> <div class="field"> <label for="familias">Atención a familias/alumnado</label> <div class="input-wrap"><input id="familias" type="number" min="0" step="1" value="1"><span>ses.</span></div> </div> <div class="field"> <label for="coordFixas">Complementarias por cargos/coordinacións</label> <div class="input-wrap"><input id="coordFixas" type="number" min="0" step="1" value="0"><span>ses.</span></div> </div> <div class="field"> <label for="outrasFixas">Outras complementarias fixas</label> <div class="input-wrap"><input id="outrasFixas" type="number" min="0" step="1" value="0"><span>ses.</span></div> </div> </div> </div>  <div class="sim-block last"> <div class="sim-block-title"><span>5</span> Só se superas 18 lectivas</div> <div class="choice-row stacked"> <label class="choice"><input id="inspeccion" type="checkbox"><span><b>Existe autorización do Servizo Territorial de Inspección Educativa</b></span></label> <label class="choice"><input id="conformidadeAfins" type="checkbox"><span><b>Se o exceso inclúe materias afíns, existe conformidade do profesorado afectado</b></span></label> </div> </div>  <div class="sim-help"> Este comprobador non converte automaticamente sesións en horas: a resolución indica que a duración dos períodos lectivos depende da tipoloxía de centro/ensinanza. As 7 h de permanencia non fixa e as 7,5 h de non obrigada permanencia forman parte do réxime semanal, pero non se usan aquí como campos para “forzar” unha suma artificial de 37,5 h. </div> </div>  <div class="sim-result"> <div> <div class="result-state"><span class="state-dot" id="stateDot"></span><h3 class="result-title" id="resultTitle">Comprobando…</h3></div>  <div class="result-metrics"> <div class="result-metric"><span>Parte lectiva calculada</span><strong id="lectTotal" class="display">18</strong><small>sesións</small></div> <div class="result-metric"><span>Complementarias fixas</span><strong id="fixTotal" class="display">5</strong><small>sesións</small></div> </div>  <div class="checks" id="dynamicChecks"></div>  <div class="regime-box" id="regimeBox"></div> </div> </div> </div> </section>  <footer class="footer"><span>Secundaria · Bacharelato · FP · Adultos · Artísticas · Idiomas · Deportivas · Curso 2026/27</span><span>Información para o profesorado</span></footer> </article>
</BaseLayout>

<style>
.page{
  --paper: var(--color-paper);
  --ink: var(--color-ink);
  --red: var(--color-red);
  --white: #fbfaf7;
  --green: var(--color-green);
  --muted: color-mix(in srgb, var(--color-ink) 55%, transparent);
  --line: var(--rule-hair);
  --max: 1240px;
}
                    .page{width:min(var(--max),calc(100% - 40px));margin:0 auto;padding:34px 0 84px}
    .hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);gap:52px;align-items:end;margin-bottom:54px}h1{margin:0;color:var(--red);font-size:clamp(5.1rem,11vw,10.4rem);line-height:.76}.hero-copy{padding-bottom:14px;max-width:500px}.kicker{display:inline-flex;align-items:center;gap:9px;font-size:.75rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase;margin-bottom:18px}.kicker::before{content:"";width:28px;height:2px;background:var(--red)}.intro{margin:0;font-size:clamp(1rem,1.4vw,1.22rem);line-height:1.36;color:#39373e}
    .total-strip{margin:8px 0 66px;border-top:2px solid var(--ink);border-bottom:2px solid var(--ink);display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr auto 1.18fr;align-items:stretch;background:rgba(255,255,255,.18);overflow:hidden}.sum-part,.sum-total{padding:22px 18px 20px;min-height:150px;display:flex;flex-direction:column;justify-content:space-between;transition:.28s ease}.sum-part:hover{background:var(--red);color:var(--white)}.sum-part:hover .sum-label{color:rgba(255,255,255,.75)}.sum-part:hover .sum-value{color:var(--white)}.sum-label{color:var(--muted);font-size:.68rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase;transition:color .25s ease}.sum-value{margin-top:20px;color:var(--red);font-size:clamp(2.25rem,3.8vw,4.1rem);line-height:.85;transition:color .25s ease}.operator{display:grid;place-items:center;font-size:1.8rem;color:var(--muted);padding:0 4px}.sum-total{background:var(--ink);color:var(--white)}.sum-total .sum-label{color:rgba(255,255,255,.62)}.sum-total .sum-value{color:var(--white)}.sum-total small{display:block;margin-top:8px;color:rgba(255,255,255,.62);font-size:.75rem;line-height:1.25}
