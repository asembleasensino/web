---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, formatHoras, materialUrl } from "../../lib/content";
import { site } from "../../config/site";
import ArrowIcon from "../../components/ArrowIcon.astro";

export async function getStaticPaths() {
  // As entradas con `href` propio (páxinas feitas a medida) non xeran páxina
  // xenérica aquí: xa teñen a súa propia ruta Astro.
  const entries = await getCollection("materiais", ({ data }) => !data.draft && !data.href);
  return entries.map((entry) => ({
    params: { id: entry.id.replace(/\.(md|mdx)$/i, "") },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"materiais">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonical = new URL(materialUrl(entry), Astro.site);
---

<BaseLayout title={`${entry.data.title} · Materiais · ${site.shortName}`} description={entry.data.summary} canonical={canonical}>
  <article>
    <header class="mx-auto grid max-w-[1500px] gap-10 px-4 pb-16 pt-16 md:px-8 md:pb-24 md:pt-24 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <span class="eyebrow text-green">{entry.data.type}{entry.data.grupo ? ` · ${entry.data.grupo}` : ""}</span>
        <p class="mt-4 text-sm text-ink/50">{formatDate(entry.data.date)}</p>
      </div>
      <div class="lg:col-span-9">
        <h1 class="type-material-title max-w-5xl font-extrabold leading-[.94] tracking-[-.05em]">{entry.data.title}</h1>
        <p class="mt-8 max-w-3xl text-xl leading-relaxed text-ink/65">{entry.data.summary}</p>
        {entry.data.fonteTitulo && (
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-ink/50">
            Fonte: {entry.data.fonteUrl ? (
              <a class="underline decoration-ink/30 underline-offset-2 hover:decoration-ink" href={entry.data.fonteUrl} target="_blank" rel="noopener noreferrer">{entry.data.fonteTitulo}</a>
            ) : entry.data.fonteTitulo}
          </p>
        )}
        {entry.data.driveUrl && (
          <a class="mt-10 inline-flex items-center gap-2 rounded-[4px] bg-green px-6 py-4 text-xs font-black uppercase tracking-wider text-paper" href={entry.data.driveUrl} target="_blank" rel="noopener noreferrer">
            Abrir ou descargar en Drive <ArrowIcon direction="up-right" />
          </a>
        )}
      </div>
    </header>
    {entry.data.image && (
      <figure class="mx-auto max-w-[1500px] px-4 md:px-8">
        <img src={entry.data.image} alt={entry.data.imageAlt || ""} class="max-h-[680px] w-full object-cover" />
      </figure>
    )}
    {entry.data.desglose && (
      <section class="border-t border-ink/20">
        <div class="mx-auto max-w-[1500px] px-4 py-16 md:px-8 md:py-20">
          <div class="grid gap-x-6 gap-y-8 border-y border-ink py-8 sm:grid-cols-2 lg:flex lg:flex-wrap lg:items-end lg:justify-between">
            {entry.data.desglose.categorias.map((categoria) => (
              <div>
                <span class="eyebrow text-red">{categoria.nome}</span>
                <strong class="display type-material-feature mt-3 block text-red">{formatHoras(categoria.horas)}&nbsp;h</strong>
              </div>
            ))}
            <div class="border-t border-ink/20 pt-5 sm:col-span-2 lg:border-t-0 lg:border-l lg:pl-8 lg:pt-0">
              <span class="eyebrow">Total semanal</span>
              <strong class="display type-material-feature mt-3 block">{formatHoras(entry.data.desglose.totalHoras)}&nbsp;h</strong>
              {entry.data.desglose.totalNota && <p class="mt-2 max-w-xs text-xs text-ink/50">{entry.data.desglose.totalNota}</p>}
            </div>
          </div>

          <div class="grid border-b border-ink/20 sm:grid-cols-2 lg:grid-cols-3">
            {entry.data.desglose.categorias.map((categoria) => (
              <div class="border-t border-ink/20 py-8 pr-6 sm:border-l sm:pl-6 sm:first:border-l-0 lg:first:border-l-0">
                <div class="flex flex-wrap items-center gap-3">
                  <h2 class="display text-3xl">{categoria.nome}</h2>
                  <span class:list={["rounded-full px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider", categoria.presenza ? "bg-green/10 text-green" : "bg-ink/8 text-ink/60"]}>
                    {categoria.presenza ? "Presenza no centro" : "Sen presenza obrigada"}
                  </span>
                </div>
                {categoria.funcions.length > 0 && (
                  <ul class="mt-6 grid gap-0">
                    {categoria.funcions.map((funcion) => (
                      <li class="border-t border-ink/15 py-3 text-sm leading-snug text-ink/70 last:border-b">{funcion}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>

          {entry.data.desglose.reglaPractica && (
            <div class="mt-10 grid gap-1 bg-ink px-6 py-8 text-paper sm:grid-cols-[180px_1fr] sm:gap-8 sm:px-8">
              <span class="eyebrow text-red">Regra práctica</span>
              <p class="text-lg leading-snug sm:text-xl">{entry.data.desglose.reglaPractica}</p>
            </div>
          )}

          {entry.data.desglose.notas.length > 0 && (
            <div class="mt-10 grid gap-8 border-t border-ink/20 pt-10 sm:grid-cols-2">
              {entry.data.desglose.notas.map((nota) => (
                <div>
                  <span class="eyebrow text-red">{nota.titulo}</span>
                  <p class="mt-3 text-sm leading-relaxed text-ink/70">{nota.texto}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )}
    <div class="mx-auto grid max-w-[1500px] gap-10 border-t border-ink/20 px-4 py-16 md:px-8 md:py-24 lg:grid-cols-12">
      <a href="/materiais/" class="text-xs font-black uppercase tracking-wider underline decoration-green decoration-2 underline-offset-4 lg:col-span-3">← Materiais</a>
      <div class="content-body lg:col-span-8">
        <Content />
        {entry.data.tags.length > 0 && (
          <p class="mt-12 border-t border-ink/20 pt-5 text-xs text-ink/50">{entry.data.tags.join(" · ")}</p>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
