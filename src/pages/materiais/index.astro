---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getMateriais, materialUrl } from "../../lib/content";
import { site } from "../../config/site";

const materiais = await getMateriais();
---
<BaseLayout title={`Materiais · ${site.shortName}`}>
  <header class="mx-auto grid max-w-[1500px] gap-8 px-4 pb-12 pt-16 md:px-8 md:pb-20 md:pt-24 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <h1 class="display type-page-materiais">Materiais</h1>
    </div>
    <p class="max-w-sm self-end text-lg leading-relaxed text-ink/65 lg:col-span-4">Documentos abertos, reutilizables e preparados para o traballo cotián nos centros.</p>
  </header>
  <section class="mx-auto max-w-[1500px] px-4 pb-28 md:px-8">
    <div class="mb-12 grid gap-5 border-y border-ink/25 py-5 sm:grid-cols-[1fr_220px]">
      <div>
        <label for="material-search" class="sr-only">Buscar no arquivo de materiais</label>
        <input id="material-search" class="focus-ring w-full border-0 bg-transparent px-0 py-2 text-sm" type="search" placeholder="Buscar no arquivo de materiais" />
      </div>
      <div>
        <label for="material-type" class="sr-only">Filtrar por tipo de material</label>
        <select id="material-type" class="focus-ring w-full border-0 bg-transparent px-0 py-2 text-sm text-ink/65">
          <option value="">Todos os tipos</option>
          {[...new Set(materiais.map((material) => material.data.type))].sort().map((type) => <option value={type}>{type}</option>)}
        </select>
      </div>
    </div>
    <p id="material-empty" hidden class="border-y border-ink/25 py-10 text-lg font-bold text-ink/60">Non se atoparon materiais con eses criterios de busca.</p>
    {materiais.length > 0 ? (
      <div class="materiais-grid grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
        {materiais.map((material) => (
          <a
            href={materialUrl(material)}
            data-material
            data-type={material.data.type}
            data-search={`${material.data.title} ${material.data.summary}`.toLocaleLowerCase("gl")}
            class="material-card focus-ring block no-underline"
          >
            <div class="material-card-inner">
              <div class="material-visual">
                {material.data.featured && (
                  <span class="material-pin">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-7.58-7-12a7 7 0 0 1 14 0c0 4.42-7 12-7 12Z" /><circle cx="12" cy="9" r="2.5" /></svg>
                    Fixado
                  </span>
                )}
                {material.data.image ? (
                  <img src={material.data.image} alt={material.data.imageAlt || ""} loading="lazy" />
                ) : (
                  <span class="material-visual-type" aria-hidden="true">{material.data.type}</span>
                )}
              </div>
              <div class="material-body">
                <span class="eyebrow text-green">{material.data.type}{material.data.grupo ? ` · ${material.data.grupo}` : ""}</span>
                <h2 class="material-title line-clamp-2">{material.data.title}</h2>
                <p class="material-summary line-clamp-3">{material.data.summary}</p>
                <p class="material-date">{formatDate(material.data.date)}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="border-y border-ink py-16">
        <p class="max-w-xl text-xl font-bold">Os materiais publicaranse aquí desde o panel editorial e almacenaranse en Google Drive.</p>
      </div>
    )}
  </section>

  <style>
    .material-card {
      perspective: 1200px;
      outline-offset: 6px;
    }

    .material-card-inner {
      --rx: 0deg;
      --ry: 0deg;
      height: 100%;
      display: flex;
      flex-direction: column;
      background: color-mix(in srgb, var(--color-ink) 2%, var(--color-paper));
      border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
      border-radius: 4px;
      overflow: hidden;
      transform: perspective(1200px) rotateX(var(--rx)) rotateY(var(--ry)) translateZ(0);
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

    .material-card:hover .material-card-inner,
    .material-card:focus-visible .material-card-inner {
      border-color: var(--color-ink);
      box-shadow: var(--shadow-hard);
      transform: perspective(1200px) rotateX(var(--rx)) rotateY(var(--ry)) translateY(-4px);
    }

    .material-visual {
      position: relative;
      aspect-ratio: 4 / 3;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      background: color-mix(in srgb, var(--color-green) 10%, var(--color-paper));
      overflow: hidden;
    }

    .material-visual img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
    }

    .material-visual-type {
      font-family: var(--font-display);
      font-stretch: condensed;
      text-transform: uppercase;
      text-align: center;
      font-weight: 900;
      letter-spacing: -.01em;
      line-height: 1.05;
      color: color-mix(in srgb, var(--color-green) 55%, transparent);
      font-size: clamp(1.3rem, 2.6vw, 1.85rem);
    }

    .material-pin {
      position: absolute;
      top: .65rem;
      left: .65rem;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      border-radius: 999px;
      background: var(--color-ink);
      color: var(--color-paper);
      padding: .3rem .6rem .3rem .5rem;
      font-size: .62rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .05em;
    }

    .material-pin svg {
      width: .7rem;
      height: .7rem;
    }

    .material-body {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: .65rem;
      padding: 1.35rem 1.4rem 1.5rem;
    }

    .material-title {
      font-size: 1.2rem;
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -.01em;
    }

    .material-card:hover .material-title,
    .material-card:focus-visible .material-title {
      color: var(--color-green);
    }

    .material-summary {
      flex: 1;
      font-size: .85rem;
      line-height: 1.5;
      color: color-mix(in srgb, var(--color-ink) 62%, transparent);
    }

    .material-date {
      font-size: .72rem;
      color: color-mix(in srgb, var(--color-ink) 42%, transparent);
    }

    @media (hover: none) {
      .material-card-inner { transition: box-shadow .18s ease, border-color .18s ease; }
    }

    @media (prefers-reduced-motion: reduce) {
      .material-card-inner { transition: none; transform: none !important; }
    }
  </style>

  <script>
    const search = document.querySelector<HTMLInputElement>("#material-search");
    const type = document.querySelector<HTMLSelectElement>("#material-type");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-material]")];
    const normalize = (value: string) => value.normalize("NFD").replace(/[̀-ͯ]/g, "").toLocaleLowerCase("gl");
    const empty = document.querySelector<HTMLElement>("#material-empty");
    const filter = () => {
      const query = normalize(search?.value.trim() || "");
      const selectedType = type?.value || "";
      let visibleCount = 0;
      for (const card of cards) {
        const haystack = normalize(card.dataset.search || "");
        const visible = (!query || haystack.includes(query)) && (!selectedType || card.dataset.type === selectedType);
        card.classList.toggle("hidden", !visible);
        if (visible) visibleCount += 1;
      }
      if (empty) empty.hidden = visibleCount > 0;
    };
    search?.addEventListener("input", filter);
    type?.addEventListener("change", filter);

    // Pequeno efecto "3D" ao pasar o rato por riba das tarxetas: nada
    // esaxerado, só unha leve inclinación segundo a posición do cursor.
    // Só se activa con rato de precisión e sen "reduce motion".
    const canTilt = window.matchMedia("(hover: hover) and (pointer: fine)").matches
      && !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (canTilt) {
      const maxTilt = 6;
      for (const card of cards) {
        const inner = card.querySelector<HTMLElement>(".material-card-inner");
        if (!inner) continue;
        card.addEventListener("pointermove", (event) => {
          const rect = card.getBoundingClientRect();
          const px = (event.clientX - rect.left) / rect.width;
          const py = (event.clientY - rect.top) / rect.height;
          const ry = (px - 0.5) * maxTilt * 2;
          const rx = (0.5 - py) * maxTilt * 2;
          inner.style.setProperty("--rx", `${rx}deg`);
          inner.style.setProperty("--ry", `${ry}deg`);
        });
        card.addEventListener("pointerleave", () => {
          inner.style.setProperty("--rx", "0deg");
          inner.style.setProperty("--ry", "0deg");
        });
      }
    }
  </script>
</BaseLayout>
