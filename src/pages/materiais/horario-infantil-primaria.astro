---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import { site } from "../../config/site";

const title = `Horario · Infantil e Primaria · Materiais · ${site.shortName}`;
const description = "Resumo visual e comprobador interactivo do horario semanal do persoal docente de infantil e primaria, segundo a Resolución do 16 de xuño de 2026.";
---

<BaseLayout title={title} description={description}>
<article class="page">  <section class="hero"> <div> <h1 class="display">Horario<br>infantil e primaria</h1> </div>  <div class="hero-copy"> <div class="kicker">Como se configura a xornada semanal</div> <p class="intro"> Resumo visual da <strong> <a class="norm-link"
             href="https://www.edu.xunta.gal/portal/sites/web/files/resolucion_instrucions_xornada_de_traballo_docente_2026_2027_sin.pdf"
             target="_blank"
             rel="noopener noreferrer">Resolución do 16 de xuño de 2026</a> </strong> para o persoal docente que imparte educación infantil e educación primaria.
        A xornada semanal total é de <strong>37,5 horas</strong>. </p> </div> </section>  <section class="total-strip" aria-label="Distribución xeral da xornada"> <div class="sum-part"> <span class="sum-label">Presenza no centro · carácter lectivo</span> <strong class="sum-value display">23 h</strong> </div> <div class="operator">+</div>  <div class="sum-part"> <span class="sum-label">Presenza no centro · carácter non lectivo</span> <strong class="sum-value display">5 h</strong> </div> <div class="operator">+</div>  <div class="sum-part"> <span class="sum-label">Non obrigada presenza no centro</span> <strong class="sum-value display">9,5 h</strong> </div> <div class="operator">=</div>  <div class="sum-total"> <span class="sum-label">Xornada semanal total</span> <strong class="sum-value display">37,5 h</strong> <small>28 horas de presenza no centro + 9,5 horas de non obrigada presenza</small> </div> </section>  <section class="hours-grid">  <article class="hour-card"> <h2 class="card-title display">Carácter<br>lectivo</h2> <div class="mini-label">Presenza no centro</div> <div class="big-hours display">23 horas</div>  <div class="mini-label">Que computa aquí</div> <div class="functions"> <div class="function-item"> <span class="function-icon">CL</span> <div class="function-copy">Actividade lectiva / docencia co alumnado.</div> </div> <div class="function-item"> <span class="function-icon">GA</span> <div class="function-copy">Gardas que teñan carácter lectivo.</div> </div> <div class="function-item"> <span class="function-icon">RE</span> <div class="function-copy">Gardas de recreo.</div> </div> <div class="function-item"> <span class="function-icon">TR</span> <div class="function-copy">Custodia do alumnado transportado antes do inicio e despois do remate da actividade lectiva.</div> </div> </div> </article>  <article class="hour-card"> <h2 class="card-title display">Carácter<br>non lectivo</h2> <div class="mini-label">Presenza no centro</div> <div class="big-hours display">5 horas</div>  <div class="mini-label">A que se pode dedicar</div> <div class="functions"> <div class="function-item"> <span class="function-icon">RO</span> <div class="function-copy">Actividades previstas nos regulamentos orgánicos dos centros.</div> </div> <div class="function-item"> <span class="function-icon">CO</span> <div class="function-copy">Coordinacións e dinamizacións.</div> </div> <div class="function-item"> <span class="function-icon">AV</span> <div class="function-copy">Sesións de avaliación.</div> </div> <div class="function-item"> <span class="function-icon">GN</span> <div class="function-copy">Gardas que non teñan carácter lectivo.</div> </div> <div class="function-item"> <span class="function-icon">+</span> <div class="function-copy">Outras actividades non lectivas que correspondan.</div> </div> </div> </article>  <article class="hour-card"> <h2 class="card-title display">Sen presenza<br>obrigada</h2> <div class="mini-label">Non obrigada presenza no centro</div> <div class="big-hours display">9,5 horas</div>  <div class="mini-label">A que se destinan</div> <div class="functions"> <div class="function-item"> <span class="function-icon">FO</span> <div class="function-copy">Perfeccionamento e formación.</div> </div> <div class="function-item"> <span class="function-icon">PR</span> <div class="function-copy">Preparación de actividades docentes.</div> </div> <div class="function-item"> <span class="function-icon">OU</span> <div class="function-copy">Outras actividades inherentes á función docente.</div> </div> </div> </article>  </section>  <section class="practical" aria-label="Regra práctica do horario"> <div class="practical-label"> <div> <div class="practical-eyebrow">Lectura rápida do modelo</div> <div class="main display">Regra<br>práctica</div> </div> </div>  <div class="practical-content"> <div class="practical-text"> O horario semanal de presenza no centro debe sumar <strong>28 horas</strong>: <strong>23 horas de carácter lectivo + 5 horas de carácter non lectivo</strong>.
        As <strong>9,5 horas restantes</strong> forman parte da xornada semanal, pero non esixen presenza no centro. </div>  <div class="practical-models" aria-label="Resumo da distribución"> <div class="model-pill primary"><span>Lectivo</span><b>23 h</b></div> <div class="model-pill primary"><span>Non lectivo</span><b>5 h</b></div> <div class="model-pill"><span>Presenza total</span><b>28 h</b></div> <div class="model-pill"><span>Xornada total</span><b>37,5 h</b></div> </div>  <div class="practical-source"> Fonte: <a href="https://www.edu.xunta.gal/portal/sites/web/files/resolucion_instrucions_xornada_de_traballo_docente_2026_2027_sin.pdf"
           target="_blank"
           rel="noopener noreferrer">Resolución do 16 de xuño de 2026 · Xunta de Galicia <ArrowIcon direction="up-right" /></a> </div> </div> </section>  <section class="rules"> <h2 class="display">A ter<br>en conta</h2>  <div class="rule-list"> <div class="norm-rule"> <b>01</b> <div> As <strong>gardas, gardas de recreo e gardas de transporte</strong> computan na parte do horario
          de carácter lectivo cando teñen a consideración indicada na resolución. </div> </div>  <div class="norm-rule"> <b>02</b> <div> Na garda de transporte escolar debe haber <strong>1 docente por cada 50 alumnos/as ou fracción</strong>. </div> </div>  <div class="norm-rule"> <b>03</b> <div> A garda de transporte dura o <strong>tempo imprescindible</strong> entre a chegada do alumnado transportado
          e o inicio da actividade lectiva, e entre o remate das actividades e a saída do transporte. </div> </div>  <div class="norm-rule"> <b>04</b> <div> As 5 horas non lectivas poden dedicarse, entre outras, a <strong>coordinacións, dinamizacións,
          sesións de avaliación e gardas que non teñan carácter lectivo</strong>. </div> </div>  <div class="norm-rule"> <b>05</b> <div> A resolución fixa o <strong>cómputo semanal</strong>, pero non establece nesta parte unha regra xeral
          de reparto por mañás/tardes ou por días concretos. Ese detalle depende da organización do centro e das instrucións aplicables. </div> </div> </div> </section>  <section class="simulator" id="simulador"> <div class="sim-head"> <div> <div class="sim-eyebrow">Ferramenta orientativa</div> <h2 class="sim-title display">Comproba<br>o teu horario</h2> </div>  <p class="sim-desc"> Introduce <strong>o que realmente aparece no horario do profesor/a</strong>.
        O comprobador clasifica esas tarefas como lectivas ou non lectivas e verifica se a presenza semanal
        encaixa no modelo <strong>23 + 5 = 28 horas</strong>. As 9,5 horas de non obrigada presenza non se preguntan:
        veñen fixadas pola propia estrutura da xornada. </p> </div>  <div class="sim-body"> <div class="sim-form">  <section class="sim-section"> <div class="sim-step"> <span class="sim-step-num">1</span> <h3>Parte de carácter lectivo</h3> </div>  <p class="sim-section-help"> Introduce as horas semanais que realmente figuran no horario nestas categorías. </p>  <div class="field-grid"> <div class="field"> <label for="docencia">Docencia / actividade lectiva</label> <div class="input-wrap"> <input id="docencia" type="number" min="0" step=".25" value="20"> <span>h</span> </div> </div>  <div class="field"> <label for="gardasLectivas">Gardas de carácter lectivo</label> <div class="input-wrap"> <input id="gardasLectivas" type="number" min="0" step=".25" value="1"> <span>h</span> </div> </div>  <div class="field"> <label for="recreos">Gardas de recreo</label> <div class="input-wrap"> <input id="recreos" type="number" min="0" step=".25" value="1"> <span>h</span> </div> </div>  <div class="field"> <label for="transporteHoras">Gardas de transporte</label> <div class="input-wrap"> <input id="transporteHoras" type="number" min="0" step=".25" value="1"> <span>h</span> </div> </div> </div> </section>  <section class="sim-section"> <div class="sim-step"> <span class="sim-step-num">2</span> <h3>Parte de carácter non lectivo con presenza</h3> </div>  <p class="sim-section-help"> Non escribas “5” por defecto: introduce de que están feitas esas horas no horario real. </p>  <div class="field-grid"> <div class="field"> <label for="coordinacions">Coordinacións / dinamizacións</label> <div class="input-wrap"> <input id="coordinacions" type="number" min="0" step=".25" value="2"> <span>h</span> </div> </div>  <div class="field"> <label for="avaliacions">Avaliacións / reunións previstas</label> <div class="input-wrap"> <input id="avaliacions" type="number" min="0" step=".25" value="1"> <span>h</span> </div> </div>  <div class="field"> <label for="gardasNonLectivas">Gardas non lectivas</label> <div class="input-wrap"> <input id="gardasNonLectivas" type="number" min="0" step=".25" value="1"> <span>h</span> </div> </div>  <div class="field"> <label for="outrasNonLectivas">Outras tarefas non lectivas</label> <div class="input-wrap"> <input id="outrasNonLectivas" type="number" min="0" step=".25" value="1"> <span>h</span> </div> </div> </div> </section>  <section class="sim-section"> <div class="sim-step"> <span class="sim-step-num">3</span> <h3>Garda de transporte · comprobación opcional do centro</h3> </div>  <p class="sim-section-help"> Esta regra é de dotación da garda, non unha condición individual do horario. Se non queres comprobala,
            deixa o alumnado transportado en 0. </p>  <div class="field-grid"> <div class="field"> <label for="alumnadoTransporte">Alumnado transportado nesa garda</label> <div class="input-wrap"> <input id="alumnadoTransporte" type="number" min="0" step="1" value="0"> <span>al.</span> </div> </div>  <div class="field"> <label for="docentesTransporte">Docentes de garda asignados</label> <div class="input-wrap"> <input id="docentesTransporte" type="number" min="0" step="1" value="0"> <span>doc.</span> </div> </div> </div> </section>  <div class="sim-help"> O comprobador utiliza exclusivamente a estrutura recollida no apartado de Infantil e Primaria da <a href="https://www.edu.xunta.gal/portal/sites/web/files/resolucion_instrucions_xornada_de_traballo_docente_2026_2027_sin.pdf"
             target="_blank"
             rel="noopener noreferrer">Resolución do 16 de xuño de 2026</a>.
          Non decide se unha tarefa concreta debe clasificarse como lectiva ou non lectiva cando esa clasificación
          dependa da organización ou doutras instrucións do centro. </div> </div>  <div class="sim-result"> <div> <div class="result-state"> <span class="state-dot" id="stateDot"></span> <h3 class="result-title" id="resultTitle">Comprobando…</h3> </div>  <div class="summary-grid"> <div class="summary-metric"> <small>Carácter lectivo</small> <strong id="lectiveSummary">23 h</strong> </div>  <div class="summary-metric"> <small>Carácter non lectivo</small> <strong id="nonLectiveSummary">5 h</strong> </div>  <div class="summary-metric"> <small>Presenza no centro</small> <strong id="presenceSummary">28 h</strong> </div>  <div class="summary-metric"> <small>Sen presenza obrigada</small> <strong>9,5 h</strong> </div> </div>  <div class="checks"> <div class="check" id="checkLectivas"> <span class="check-mark">·</span> <span>Parte de carácter lectivo</span> <span class="expected">23 h</span> </div>  <div class="check" id="checkNonLectivas"> <span class="check-mark">·</span> <span>Parte de carácter non lectivo con presenza</span> <span class="expected">5 h</span> </div>  <div class="check" id="checkPresenza"> <span class="check-mark">·</span> <span>Presenza semanal total no centro</span> <span class="expected">28 h</span> </div>  <div class="check" id="checkTotal"> <span class="check-mark">·</span> <span>Xornada semanal ao engadir as 9,5 h sen presenza obrigada</span> <span class="expected">37,5 h</span> </div> </div>  <div class="transport-result" id="transportResult"> <small>Garda de transporte</small> <strong id="transportText">Comprobación non activada.</strong> </div> </div>  <div class="total-result"> <div> <small>Presenza calculada no centro</small> </div> <strong class="display" id="presenceCalculated">28 h</strong> </div> </div> </div> </section>  <footer class="footer"> <span>Infantil e Primaria · Curso 2026/27</span> <span> <a class="norm-link"
         href="https://www.edu.xunta.gal/portal/sites/web/files/resolucion_instrucions_xornada_de_traballo_docente_2026_2027_sin.pdf"
         target="_blank"
         rel="noopener noreferrer">Resolución do 16 de xuño de 2026 <ArrowIcon direction="up-right" /></a> </span> </footer>  </article>
</BaseLayout>

<style>
.page{
  --paper: var(--color-paper);
  --ink: var(--color-ink);
  --red: var(--color-red);
  --white: #fbfaf7;
  --green: var(--color-green);
  --muted: color-mix(in srgb, var(--color-ink) 55%, transparent);
  --line: var(--rule-hair);
  --max: 1240px;
}
.page{
      width:min(var(--max),calc(100% - 40px));
      margin:0 auto;
      padding:34px 0 84px;
    }


    .hero{
      display:grid;
      grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);
      gap:52px;
      align-items:end;
      margin-bottom:54px;
    }

    h1{
      margin:0;
      color:var(--red);
      font-size:clamp(5.6rem,12.7vw,11.4rem);
      line-height:.74;
    }

    .hero-copy{
      padding-bottom:14px;
      max-width:500px;
    }

    .kicker{
      display:inline-flex;
      align-items:center;
      gap:9px;
      font-size:.75rem;
      font-weight:800;
      letter-spacing:.13em;
      text-transform:uppercase;
      margin-bottom:18px;
    }

    .kicker::before{
      content:"";
      width:28px;
      height:2px;
      background:var(--red);
    }

    .intro{
      margin:0;
      font-size:clamp(1rem,1.4vw,1.22rem);
      line-height:1.36;
      color:#39373e;
    }

    a.norm-link{
      color:inherit;
      text-decoration-color:rgba(201,74,66,.58);
      text-decoration-thickness:2px;
      text-underline-offset:3px;
    }

    a.norm-link:hover{color:var(--red)}

    /* SUMA */
    .total-strip{
      margin:8px 0 66px;
      border-top:2px solid var(--ink);
      border-bottom:2px solid var(--ink);
      display:grid;
      grid-template-columns:1fr auto 1fr auto 1fr auto 1.16fr;
      align-items:stretch;
      background:rgba(255,255,255,.18);
      overflow:hidden;
    }

    .sum-part,.sum-total{
      padding:24px 22px 22px;
      min-height:146px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      transition:.28s ease;
    }

    .sum-part:hover{
      background:var(--red);
      color:var(--white);
    }

    .sum-part:hover .sum-label{color:rgba(255,255,255,.75)}
    .sum-part:hover .sum-value{color:var(--white)}

    .sum-label{
      color:var(--muted);
      font-size:.7rem;
      font-weight:800;
      letter-spacing:.11em;
      text-transform:uppercase;
      transition:color .25s ease;
    }

    .sum-value{
      margin-top:20px;
      color:var(--red);
      font-size:clamp(2.5rem,4.5vw,4.6rem);
      line-height:.85;
      transition:color .25s ease;
    }

    .operator{
      display:grid;
      place-items:center;
      font-size:2rem;
      color:var(--muted);
      padding:0 6px;
    }

    .sum-total{
      background:var(--ink);
      color:var(--white);
    }

    .sum-total .sum-label{color:rgba(255,255,255,.62)}
    .sum-total .sum-value{color:var(--white)}

    .sum-total small{
      display:block;
      margin-top:8px;
      color:rgba(255,255,255,.62);
      font-size:.76rem;
      line-height:1.25;
    }

    /* CARDS */
    .hours-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      border-top:2px solid var(--ink);
      border-bottom:2px solid var(--ink);
    }

    .hour-card{
      position:relative;
      min-height:640px;
      padding:30px 30px 34px;
      overflow:hidden;
      isolation:isolate;
      transition:transform .32s cubic-bezier(.2,.8,.2,1),color .3s ease;
    }

    .hour-card + .hour-card{border-left:2px solid var(--ink)}

    .hour-card::before{
      content:"";
      position:absolute;
      inset:0;
      background:var(--red);
      transform:translateY(102%);
      transition:transform .36s cubic-bezier(.2,.8,.2,1);
      z-index:-1;
    }

    .hour-card:hover{
      color:var(--white);
      transform:translateY(-5px);
    }

    .hour-card:hover::before{transform:translateY(0)}
    .hour-card:hover .card-title,
    .hour-card:hover .big-hours{color:var(--white)}
    .hour-card:hover .mini-label,
    .hour-card:hover .function-copy{color:rgba(255,255,255,.86)}
    .hour-card:hover .function-item{border-color:rgba(255,255,255,.28)}
    .hour-card:hover .function-icon{
      background:rgba(255,255,255,.13);
      color:var(--white);
      border-color:rgba(255,255,255,.26);
    }

    .card-title{
      color:var(--red);
      font-size:clamp(2.35rem,4vw,4.15rem);
      line-height:.85;
      text-transform:uppercase;
      min-height:112px;
      transition:color .3s ease;
    }

    .mini-label{
      margin-top:20px;
      color:var(--muted);
      font-size:.7rem;
      text-transform:uppercase;
      letter-spacing:.12em;
      font-weight:800;
      transition:color .3s ease;
    }

    .big-hours{
      color:var(--red);
      font-size:clamp(3rem,5vw,4.8rem);
      line-height:.86;
      margin-top:8px;
      transition:color .3s ease;
    }

    .functions{
      margin-top:30px;
      border-top:1px solid var(--line);
    }

    .function-item{
      display:grid;
      grid-template-columns:42px 1fr;
      gap:12px;
      align-items:start;
      padding:14px 0;
      border-bottom:1px solid var(--line);
      transition:border-color .25s ease,transform .2s ease;
    }

    .function-item:hover{transform:translateX(5px)}

    .function-icon{
      width:34px;
      height:34px;
      border:1px solid rgba(36,35,41,.18);
      border-radius:50%;
      display:grid;
      place-items:center;
      font-size:.8rem;
      font-weight:900;
      color:var(--red);
      background:rgba(255,255,255,.24);
      transition:.25s ease;
    }

    .function-copy{
      font-size:clamp(.96rem,1.2vw,1.08rem);
      line-height:1.22;
      color:#343239;
      transition:color .25s ease;
    }

    /* REGRA PRÁCTICA */
    .practical{
      margin-top:64px;
      position:relative;
      display:grid;
      grid-template-columns:minmax(230px,.7fr) minmax(0,1.75fr);
      overflow:hidden;
      border:2px solid var(--ink);
      background:var(--white);
      box-shadow:0 26px 70px rgba(36,35,41,.11);
    }

    .practical::after{
      content:"23 + 5";
      position:absolute;
      right:-10px;
      bottom:-34px;
      color:rgba(201,74,66,.07);
      font-family:var(--font-display);
      font-weight:900;
      font-size:clamp(7rem,15vw,13rem);
      line-height:.8;
      pointer-events:none;
    }

    .practical-label{
      position:relative;
      background:var(--red);
      padding:28px 26px 26px;
      color:var(--white);
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      min-height:250px;
    }

    .practical-label::after{
      content:"→";
      font-family:Inter,ui-sans-serif,system-ui,sans-serif;
      font-size:2rem;
      font-weight:400;
      opacity:.72;
    }

    .practical-label .practical-eyebrow{
      font-family:Inter,ui-sans-serif,system-ui,sans-serif;
      font-size:.68rem;
      line-height:1.2;
      letter-spacing:.13em;
      text-transform:uppercase;
      font-weight:900;
      opacity:.72;
      margin-bottom:12px;
    }

    .practical-label .main{
      font-size:clamp(2.5rem,4vw,4.4rem);
      line-height:.78;
      text-transform:uppercase;
    }

    .practical-content{
      position:relative;
      z-index:1;
      padding:30px 34px 28px;
      display:grid;
      grid-template-columns:minmax(0,1fr) auto;
      gap:28px;
      align-items:center;
    }

    .practical-text{
      font-size:clamp(1.2rem,2vw,1.85rem);
      line-height:1.12;
    }

    .practical-text strong{color:var(--red)}

    .practical-models{
      display:grid;
      gap:8px;
      min-width:220px;
    }

    .model-pill{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:16px;
      border-top:1px solid var(--line);
      padding:10px 0;
      font-size:.8rem;
    }

    .model-pill:first-child{border-top:0}

    .model-pill span{
      color:var(--muted);
      text-transform:uppercase;
      letter-spacing:.08em;
      font-size:.66rem;
      font-weight:900;
    }

    .model-pill b{
      font-size:1rem;
      white-space:nowrap;
    }

    .model-pill.primary b{color:var(--green)}

    .practical-source{
      grid-column:1/-1;
      padding-top:16px;
      border-top:1px solid var(--line);
      font-size:.78rem;
      color:var(--muted);
    }

    .practical-source a{
      font-weight:800;
      color:var(--ink);
      text-decoration-color:var(--red);
      text-underline-offset:3px;
    }

    .practical-source a:hover{color:var(--red)}

    /* NOTAS */
    .rules{
      margin-top:62px;
      display:grid;
      grid-template-columns:280px 1fr;
      gap:34px;
    }

    .rules h2{
      margin:0;
      color:var(--red);
      font-size:clamp(2.8rem,4vw,4.4rem);
      line-height:.84;
      text-transform:uppercase;
    }

    .rule-list{border-top:1px solid var(--line)}

    .norm-rule{
      display:grid;
      grid-template-columns:48px 1fr;
      gap:14px;
      padding:16px 0;
      border-bottom:1px solid var(--line);
      align-items:start;
    }

    .norm-rule b{
      color:var(--red);
      font-size:1.2rem;
    }

    .norm-rule div{
      font-size:1.05rem;
      line-height:1.35;
    }

    /* COMPROBADOR */
    .simulator{
      margin-top:76px;
      background:var(--ink);
      color:var(--white);
      border-radius:2px;
      overflow:hidden;
      box-shadow:0 30px 80px rgba(36,35,41,.16);
    }

    .sim-head{
      display:grid;
      grid-template-columns:1fr .85fr;
      gap:40px;
      padding:34px 36px 28px;
      border-bottom:1px solid rgba(255,255,255,.18);
    }

    .sim-eyebrow{
      color:#e07169;
      text-transform:uppercase;
      letter-spacing:.12em;
      font-size:.72rem;
      font-weight:900;
      margin-bottom:8px;
    }

    .sim-title{
      margin:0;
      font-size:clamp(3rem,6vw,6rem);
      line-height:.8;
      text-transform:uppercase;
    }

    .sim-desc{
      align-self:end;
      color:rgba(255,255,255,.68);
      line-height:1.4;
      font-size:.96rem;
      max-width:470px;
    }

    .sim-body{
      display:grid;
      grid-template-columns:1.08fr .92fr;
      min-height:520px;
    }

    .sim-form{
      padding:30px 36px 38px;
      border-right:1px solid rgba(255,255,255,.18);
    }

    .sim-section{
      padding-bottom:26px;
      margin-bottom:26px;
      border-bottom:1px solid rgba(255,255,255,.12);
    }

    .sim-section:last-child{
      margin-bottom:0;
      border-bottom:0;
      padding-bottom:0;
    }

    .sim-step{
      display:flex;
      align-items:center;
      gap:10px;
      margin-bottom:16px;
    }

    .sim-step-num{
      width:28px;
      height:28px;
      border-radius:50%;
      display:grid;
      place-items:center;
      background:var(--red);
      font-weight:900;
      font-size:.8rem;
      flex:0 0 auto;
    }

    .sim-step h3{
      margin:0;
      font-size:1.05rem;
    }

    .sim-section-help{
      margin:-6px 0 16px;
      color:rgba(255,255,255,.5);
      font-size:.78rem;
      line-height:1.4;
    }

    .field-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:18px 16px;
    }

    .field label{
      display:block;
      color:rgba(255,255,255,.66);
      font-size:.7rem;
      font-weight:800;
      letter-spacing:.08em;
      text-transform:uppercase;
      margin-bottom:7px;
    }

    .input-wrap{
      display:flex;
      align-items:center;
      border-bottom:1px solid rgba(255,255,255,.35);
    }

    .input-wrap input{
      width:100%;
      border:0;
      outline:0;
      background:transparent;
      color:white;
      padding:9px 0 8px;
      font-size:1.85rem;
      font-weight:700;
    }

    .input-wrap span{
      color:rgba(255,255,255,.48);
      font-size:.84rem;
      white-space:nowrap;
    }

    .sim-help{
      margin-top:24px;
      padding-top:18px;
      border-top:1px solid rgba(255,255,255,.12);
      color:rgba(255,255,255,.55);
      font-size:.78rem;
      line-height:1.42;
    }

    .sim-help a{color:#f1a099}

    .sim-result{
      padding:30px 36px 38px;
      background:#1e1d22;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .result-state{
      display:flex;
      align-items:center;
      gap:12px;
      margin-bottom:22px;
    }

    .state-dot{
      width:14px;
      height:14px;
      border-radius:50%;
      background:#a19c95;
      box-shadow:0 0 0 6px rgba(255,255,255,.05);
      flex:0 0 auto;
    }

    .state-dot.ok{background:#7fb293}
    .state-dot.warn{background:#d1aa63}
    .state-dot.bad{background:#dc746d}

    .result-title{
      margin:0;
      font-size:clamp(1.7rem,3vw,2.55rem);
      line-height:1;
    }

    .summary-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      margin:0 0 22px;
    }

    .summary-metric{
      padding:14px;
      background:rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.08);
    }

    .summary-metric small{
      display:block;
      color:rgba(255,255,255,.46);
      text-transform:uppercase;
      letter-spacing:.08em;
      font-size:.65rem;
    }

    .summary-metric strong{
      display:block;
      margin-top:6px;
      font-size:1.55rem;
    }

    .checks{display:grid;gap:10px}

    .check{
      display:grid;
      grid-template-columns:24px 1fr auto;
      gap:10px;
      align-items:start;
      padding:11px 0;
      border-bottom:1px solid rgba(255,255,255,.10);
      font-size:.92rem;
      line-height:1.3;
    }

    .check-mark{
      width:20px;
      height:20px;
      border-radius:50%;
      display:grid;
      place-items:center;
      background:rgba(255,255,255,.08);
      font-size:.7rem;
      margin-top:1px;
    }

    .check.ok .check-mark{background:#315b46}
    .check.bad .check-mark{background:#7b3330}
    .check.warn .check-mark{background:#785a28}

    .check .expected{
      color:rgba(255,255,255,.46);
      font-size:.76rem;
      text-align:right;
      max-width:145px;
    }

    .transport-result{
      margin-top:24px;
      padding:16px;
      background:rgba(255,255,255,.045);
      border-top:2px solid var(--red);
    }

    .transport-result small{
      display:block;
      color:rgba(255,255,255,.48);
      font-size:.68rem;
      text-transform:uppercase;
      letter-spacing:.08em;
      font-weight:800;
      margin-bottom:6px;
    }

    .transport-result strong{
      font-size:1.18rem;
      line-height:1.25;
    }

    .total-result{
      margin-top:22px;
      padding-top:18px;
      border-top:1px solid rgba(255,255,255,.18);
      display:flex;
      justify-content:space-between;
      align-items:end;
      gap:20px;
    }

    .total-result small{
      color:rgba(255,255,255,.5);
      text-transform:uppercase;
      letter-spacing:.08em;
      font-weight:800;
    }

    .total-result strong{
      font-size:3rem;
      line-height:.8;
    }

    .footer{
      margin-top:70px;
      padding-top:18px;
      border-top:1px solid var(--line);
      display:flex;
      justify-content:space-between;
      gap:20px;
      font-size:.76rem;
      color:var(--muted);
    }

    @media(max-width:980px){
      .hero,.sim-head,.sim-body,.rules{grid-template-columns:1fr}
      .hours-grid{grid-template-columns:1fr;border-bottom:0}
      .hour-card{min-height:auto;border-bottom:2px solid var(--ink)}
      .hour-card + .hour-card{border-left:0}
      .total-strip{
        grid-template-columns:1fr;
        border:0;
        gap:2px;
        background:transparent;
      }
      .operator{display:none}
      .sum-part,.sum-total{min-height:auto;border:1px solid var(--line)}
      .practical{grid-template-columns:1fr}
      .practical-label{min-height:auto}
      .practical-label::after{display:none}
      .practical-content{grid-template-columns:1fr}
      .practical-models{min-width:0}
      .sim-form{border-right:0;border-bottom:1px solid rgba(255,255,255,.18)}
    }

    @media(max-width:620px){
      .page{width:min(100% - 24px,var(--max));padding-top:18px}
      h1{font-size:clamp(4.2rem,21vw,7rem)}
      .field-grid,.summary-grid{grid-template-columns:1fr}
      .sim-head,.sim-form,.sim-result{padding-left:20px;padding-right:20px}
      .footer{flex-direction:column}
      .hour-card:hover{transform:none}
      .check{grid-template-columns:24px 1fr}
      .check .expected{grid-column:2;text-align:left;max-width:none;margin-top:-5px}
    }

    @media(prefers-reduced-motion:reduce){
      *{transition:none!important;scroll-behavior:auto!important}
    }
  </style>

<script is:inline>

  const scheduleIds = [
    "docencia",
    "gardasLectivas",
    "recreos",
    "transporteHoras",
    "coordinacions",
    "avaliacions",
    "gardasNonLectivas",
    "outrasNonLectivas",
    "alumnadoTransporte",
    "docentesTransporte"
  ];

  const val = id => {
    const n = parseFloat(document.getElementById(id).value);
    return Number.isFinite(n) ? Math.max(0,n) : 0;
  };

  const near = (a,b) => Math.abs(a-b) < 0.001;

  function fmt(n){
    return n.toLocaleString("gl-ES",{maximumFractionDigits:2}) + " h";
  }

  function setCheck(id,state,detail){
    const el = document.getElementById(id);
    el.classList.remove("ok","bad","warn");
    el.classList.add(state);
    el.querySelector(".check-mark").textContent =
      state === "ok" ? "✓" : state === "warn" ? "!" : "×";
    el.querySelector(".expected").textContent = detail;
  }

  function updateSimulator(){
    const lectivas =
      val("docencia") +
      val("gardasLectivas") +
      val("recreos") +
      val("transporteHoras");

    const nonLectivas =
      val("coordinacions") +
      val("avaliacions") +
      val("gardasNonLectivas") +
      val("outrasNonLectivas");

    const presenza = lectivas + nonLectivas;
    const total = presenza + 9.5;

    const okLectivas = near(lectivas,23);
    const okNonLectivas = near(nonLectivas,5);
    const okPresenza = near(presenza,28);
    const okTotal = near(total,37.5);

    document.getElementById("lectiveSummary").textContent = fmt(lectivas);
    document.getElementById("nonLectiveSummary").textContent = fmt(nonLectivas);
    document.getElementById("presenceSummary").textContent = fmt(presenza);
    document.getElementById("presenceCalculated").textContent = fmt(presenza);

    setCheck(
      "checkLectivas",
      okLectivas ? "ok" : "bad",
      `${fmt(lectivas)} / 23 h`
    );

    setCheck(
      "checkNonLectivas",
      okNonLectivas ? "ok" : "bad",
      `${fmt(nonLectivas)} / 5 h`
    );

    setCheck(
      "checkPresenza",
      okPresenza ? "ok" : "bad",
      `${fmt(presenza)} / 28 h`
    );

    setCheck(
      "checkTotal",
      okTotal ? "ok" : "bad",
      `${fmt(total)} / 37,5 h`
    );

    const alumnado = Math.floor(val("alumnadoTransporte"));
    const docentes = Math.floor(val("docentesTransporte"));
    const transportText = document.getElementById("transportText");
    const transportBox = document.getElementById("transportResult");

    let transportState = "neutral";

    if(alumnado <= 0){
      transportText.textContent = "Comprobación non activada.";
      transportBox.style.borderTopColor = "var(--red)";
    }else{
      const minimo = Math.ceil(alumnado / 50);
      const ok = docentes >= minimo;
      transportState = ok ? "ok" : "bad";

      transportText.textContent = ok
        ? `${docentes} docente(s) asignado(s). Mínimo normativo: ${minimo}.`
        : `${docentes} docente(s) asignado(s). Fan falta como mínimo ${minimo}.`;

      transportBox.style.borderTopColor = ok ? "#7fb293" : "#dc746d";
    }

    const dot = document.getElementById("stateDot");
    const title = document.getElementById("resultTitle");
    dot.className = "state-dot";

    const scheduleOK = okLectivas && okNonLectivas && okPresenza && okTotal;

    if(scheduleOK){
      if(transportState === "bad"){
        dot.classList.add("warn");
        title.textContent = "O horario encaixa, pero revisa a garda de transporte";
      }else{
        dot.classList.add("ok");
        title.textContent = "O horario encaixa no modelo";
      }
    }else{
      const mainChecks = [okLectivas,okNonLectivas,okPresenza,okTotal];
      const okCount = mainChecks.filter(Boolean).length;

      if(okCount >= 2){
        dot.classList.add("warn");
        title.textContent = "Hai puntos que revisar";
      }else{
        dot.classList.add("bad");
        title.textContent = "A distribución non encaixa";
      }
    }
  }

  scheduleIds.forEach(id => {
    document.getElementById(id).addEventListener("input",updateSimulator);
  });

  updateSimulator();
</script>
